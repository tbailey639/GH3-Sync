<Window x:Class="GH3_Sync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync v1.0.0"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1360" Height="880"
        MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#090A0F"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <ResourceDictionary Source="AppTheme.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 5-Fret Accent Strip -->
        <Border Grid.Row="0" Background="{StaticResource FretBarGradient}"/>

        <!-- ==================== TOP HEADER BAR ==================== -->
        <Border Grid.Row="1" Background="#0E1017" BorderBrush="#262B3D" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/gh3_sync_logo.png"
                           Width="40" Height="40" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GH3" FontSize="21" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="-SYNC" FontSize="21" FontWeight="Black" Foreground="{StaticResource FlameGradient}"/>
                            <Border Background="#1F1824" BorderBrush="#EA580C" BorderThickness="1" CornerRadius="5" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.0.0" FontSize="10.5" FontWeight="Bold" Foreground="#FB923C"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Guitar Hero III Companion  •  by Mad Scientist" FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="GameStatusPill" Background="#12211A" BorderBrush="#10B981" BorderThickness="1"
                            CornerRadius="16" Padding="11,5" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
                            <TextBlock x:Name="GameStatusText" Text="BetterGH3 Ready" FontSize="12" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                        </StackPanel>
                    </Border>

                    <Button Content="▶ Launch GH3" Style="{StaticResource GreenButton}" Padding="13,7" Margin="0,0,8,0" Click="LaunchGh3Btn_Click"/>
                    <Button x:Name="HeaderUpdateBtn" Content="Check Updates" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="CheckUpdatesBtn_Click"/>
                    <Button Content="Settings" Style="{StaticResource OutlineButton}" Click="GameConfigBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== UPDATE BANNER ==================== -->
        <Border x:Name="UpdateBanner" Grid.Row="2" Visibility="Collapsed"
                Background="#241A0B" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerTitle" Text="Update available" FontSize="13.5" FontWeight="Bold" Foreground="#FCD34D"/>
                    <TextBlock x:Name="UpdateBannerSubtitle" Text="Click Update Now to download and install." FontSize="12" Foreground="#FDE68A" Margin="0,2,0,0"/>
                    <ProgressBar x:Name="UpdateBannerProgress" Visibility="Collapsed" Height="8" Margin="0,8,16,0" Minimum="0" Maximum="100"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNowBtn" Content="Update Now" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Click="UpdateNowBtn_Click"/>
                    <Button Content="✕" Style="{StaticResource OutlineButton}" Padding="10,6" Click="DismissUpdateBanner_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN BODY ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="#0E1017" BorderBrush="#262B3D" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="#141722" BorderBrush="#262B3D" BorderThickness="1"
                            CornerRadius="10" Margin="10" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="SidebarProfileName" Text="Player" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="SidebarFriendCode" Text="GH3-XXXX-XXXX" FontSize="11.5" Foreground="#FB923C" FontFamily="Consolas" Margin="0,2,0,4"/>
                            <TextBlock x:Name="SidebarLobbySummary" Text="Lobby Auto-Sync: 0 / 10" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="LIBRARY" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="18,6,0,6"/>
                            <RadioButton x:Name="NavCustoms" Content="My Customs" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavCreator" Content="ONOGAMI Song Creator" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAiTools" Content="Tools &amp; Stems" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>

                            <TextBlock Text="MULTIPLAYER" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavFriends" Content="Friends &amp; Trust" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavP2P" Content="P2P Sync &amp; Lobby" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavImport" Content="Import &amp; Convert" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>

                            <TextBlock Text="SYSTEM" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavSaves" Content="Career Saves" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAbout" Content="About, Logs &amp; Credits" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CONTENT PAGES -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <Grid>

                    <!-- ==================== PAGE 1: MY CUSTOMS ==================== -->
                    <StackPanel x:Name="PageCustoms">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CustomsHeaderTitle" Text="Installed Custom Songs" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="CustomsGamePathLabel" Text="Scanning library..." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Refresh" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="RefreshSongs_Click"/>
                                <Button x:Name="ExportSelectedBtn" Content="Export Selected (0)" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="ExportSelectedPack_Click"/>
                                <Button Content="Export All (.gh3pack)" Style="{StaticResource FlameButton}" Click="ExportAllPack_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter, Sort & Search Bar -->
                        <Border Style="{StaticResource GhCard}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FilterAllBtn" Content="All" Style="{StaticResource FlameButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="all"/>
                                    <Button x:Name="FilterCreatedBtn" Content="Created by Me" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="created"/>
                                    <Button x:Name="FilterSyncedBtn" Content="Synced / Imported" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="synced"/>
                                    <Button x:Name="FilterFavBtn" Content="★ Favorites" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="favorites"/>
                                    <Button x:Name="FilterLobbyBtn" Content="Lobby Setlist (0/10)" Style="{StaticResource OutlineButton}" Padding="11,6" Click="FilterSongs_Click" Tag="lobby"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="SongSortCombo" Width="128" Margin="0,0,8,0" SelectionChanged="SongSortCombo_SelectionChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Sort: Title A-Z"/>
                                        <ComboBoxItem Content="Sort: Artist A-Z"/>
                                        <ComboBoxItem Content="Sort: Newest"/>
                                        <ComboBoxItem Content="Sort: Largest"/>
                                    </ComboBox>
                                    <TextBox x:Name="SongSearchBox" Width="195" TextChanged="SongSearchBox_TextChanged" ToolTip="Search title, artist, or song ID"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Tip: Drag and drop any .gh3song, .gh3pack, Clone Hero .zip/folder, or audio file directly onto this window."
                                   FontSize="11.5" Foreground="#64748B" Margin="2,-4,0,10"/>

                        <StackPanel x:Name="SongsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 2: SONG CREATOR ==================== -->
                    <StackPanel x:Name="PageCreator" Visibility="Collapsed">
                        <TextBlock Text="ONOGAMI Song Creator" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Create custom songs with dynamic beat tracking, pitch-mapped charting, stem separation, and batch compilation."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,14"/>

                        <!-- Compiler & Auto-Install Bar -->
                        <Border Style="{StaticResource GhCard}" Background="#0D1F18" BorderBrush="#10B981" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Song Compiler" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                                        <Border Background="#064E3B" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorCompilerBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#6EE7B7"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorCompilerMsg" Text="Compiles .pak.xen chart and .fsb.xen audio soundbanks directly into Guitar Hero III."
                                               FontSize="12" Foreground="#A7F3D0" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CrAutoCompileChk" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                          Content="Auto-Compile &amp; Install into Game" Foreground="#34D399" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Stem Separator Bar -->
                        <Border Style="{StaticResource GhCard}" Background="#10182B" BorderBrush="#3B82F6" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Multi-Track Stem Separation (Demucs 6-Stem + Basic Pitch)" FontSize="14" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <Border x:Name="CreatorAiBadgeBorder" Background="#1E3A8A" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorAiBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#BFDBFE"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorAiMsg" Text="Isolates Guitar, Bass, Drums, Vocals &amp; Piano for mute-on-miss gameplay and cleaner note transcription."
                                               FontSize="12" Foreground="#93C5FD" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CrSeparateStemsChk" Content="Separate Stems" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <Button x:Name="CreatorQuickInstallAiBtn" Content="Install Stem Tools" Style="{StaticResource BlueButton}" Padding="12,6" Click="GoToAiManager_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Main Form Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Chart Mode" FontSize="12.5" FontWeight="Bold" Foreground="#FB923C" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="ModeAutoGenRadio" Content="Auto-Generate Chart from Audio" Foreground="White" FontSize="13" IsChecked="True" Margin="0,0,24,0" Checked="ChartMode_Changed"/>
                                    <RadioButton x:Name="ModeUploadRadio" Content="Use Existing Chart / MIDI (.chart or .mid)" Foreground="White" FontSize="13" Checked="ChartMode_Changed"/>
                                </StackPanel>

                                <!-- File Pickers -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Audio File (.mp3, .wav, .ogg) *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="▶ Preview" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="PreviewCreatorAudioBtn_Click"/>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="BrowseAudioBtn_Click"/>
                                            <TextBox x:Name="CrAudioPathBox" IsReadOnly="True"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="ChartPickerPanel" Grid.Column="2" Visibility="Collapsed">
                                        <TextBlock Text="Chart / MIDI File (.chart or .mid) *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="BrowseChartBtn_Click"/>
                                            <TextBox x:Name="CrChartPathBox" IsReadOnly="True"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="BpmPickerPanel" Grid.Column="2">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="Detect BPM" Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="11" Click="DetectBpmBtn_Click"/>
                                            <TextBlock Text="Tempo (BPM)" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="BpmStatusLabel" DockPanel.Dock="Right" Text="" FontSize="11.5" Foreground="#34D399" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBox x:Name="CrBpmBox" Text="130"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Auto-Chart Tuning Row -->
                                <Grid x:Name="ChartTuningRow" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Chart Density / Feel" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrFeelCombo" SelectedIndex="1">
                                            <ComboBoxItem Content="Casual"/>
                                            <ComboBoxItem Content="Standard"/>
                                            <ComboBoxItem Content="Shredder"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Instrument Focus (when stems split)" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrFocusCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Guitar"/>
                                            <ComboBoxItem Content="Bass"/>
                                            <ComboBoxItem Content="Vocals"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                        <CheckBox x:Name="CrVariableTempoChk" IsChecked="True" Content="Dynamic Variable Tempo Map" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="CrPreviewStartLabel" Text="Menu Preview Start: 5.0s" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Metadata Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Song Title *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrTitleBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Artist Name *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrArtistBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Album" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrAlbumBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Year" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrYearBox" Text="2026"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Genre" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrGenreBox" Text="Rock"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="Charter Name" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrCharterBox" Text="Mad Scientist"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Actions + Batch Queue -->
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CreateSongSubmitBtn" Content="Create &amp; Compile Song" Style="{StaticResource FlameButton}" Padding="20,10" FontSize="13.5" Click="CreateSongBtn_Click"/>
                                        <Button Content="+ Add to Batch Queue" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="AddToQueueBtn_Click"/>
                                        <Button x:Name="RunQueueBtn" Content="Compile Batch Queue (0)" Style="{StaticResource GreenButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="RunQueueBtn_Click"/>
                                        <TextBlock x:Name="CrProgressLabel" Text="" FontSize="12" Foreground="#FCD34D" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BatchQueueListText" Visibility="Collapsed" FontSize="11.5" Foreground="#94A3B8" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                    <ProgressBar x:Name="CrProgressBar" Visibility="Collapsed" Height="10" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
                                    <Border x:Name="CrResultBox" Visibility="Collapsed" Margin="0,12,0,0" CornerRadius="8" Padding="12" Background="#0D221A" BorderBrush="#10B981" BorderThickness="1">
                                        <TextBlock x:Name="CrResultText" TextWrapping="Wrap" Foreground="#A7F3D0" FontSize="12.5"/>
                                    </Border>
                                </StackPanel>

                                <!-- GH3 Save Notice -->
                                <Border Background="#241A0B" BorderBrush="#D97706" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,14,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#FDE68A"
                                               Text="Note: Adding custom songs updates customs.pak.xen, which causes Guitar Hero III to prompt for a save reset on next launch. Use the Batch Queue to compile multiple songs at once, or back up your career profile in Career Saves first."/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 3: TOOLS & STEMS ==================== -->
                    <StackPanel x:Name="PageAiTools" Visibility="Collapsed">
                        <TextBlock Text="Tools &amp; Stem Separation" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Manage the song compiler and optional 6-stem separation package." FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Honeycomb Compiler &amp; FFmpeg" FontSize="15.5" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="AiToolsCompilerPath" Text="Checking..." FontSize="12" Foreground="#94A3B8" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock x:Name="AiToolsCompilerStatus" Text="Ready" FontSize="12" FontWeight="Bold" Foreground="#6EE7B7"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GhCard}" BorderBrush="#3B82F6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Demucs 6-Stem (htdemucs_6s) + Basic Pitch" FontSize="15.5" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <TextBlock Text="Separates songs into isolated Guitar, Bass, Drums, Vocals &amp; Piano stems and transcribes guitar MIDI notes. Installs automatically to AppData."
                                                   FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border x:Name="AiStatusPill" Grid.Column="1" Background="#3B2F0C" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="AiStatusPillText" Text="Not Installed" FontSize="12" FontWeight="Bold" Foreground="#FDE047"/>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,4,0,14">
                                    <Border Background="#0C0E14" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompDemucs" Text="Demucs 6-Stem: Checking..." FontSize="12" Foreground="#CBD5E1"/>
                                    </Border>
                                    <Border Background="#0C0E14" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompBasicPitch" Text="Basic Pitch MIDI: Checking..." FontSize="12" Foreground="#CBD5E1"/>
                                    </Border>
                                    <Border Background="#0C0E14" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompSize" Text="Disk Usage: 0 MB" FontSize="12" Foreground="#94A3B8"/>
                                    </Border>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallAiBtn" Content="Install Stem Tools (~700 MB - 1.2 GB)" Style="{StaticResource FlameButton}" Padding="16,9" Click="InstallAiEngineBtn_Click"/>
                                    <Button x:Name="UninstallAiBtn" Content="Uninstall" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="UninstallAiEngineBtn_Click"/>
                                    <Button Content="Open Folder" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="OpenAiFolderBtn_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="AiInstallProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock x:Name="AiInstallStepText" Text="Starting installation..." FontSize="12" Foreground="#FCD34D" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="AiInstallProgressBar" Height="11" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 4: FRIENDS & TRUST ==================== -->
                    <StackPanel x:Name="PageFriends" Visibility="Collapsed">
                        <TextBlock Text="Friends &amp; Trusted Network" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Trusted friends share addresses automatically without manual IP or PIN entry. Regular friends require a session PIN."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Display Name" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource FlameButton}" Margin="8,0,0,0" Click="SaveUsernameBtn_Click"/>
                                        <TextBox x:Name="ProfileUsernameBox"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Permanent Friend Code" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="CopyFriendCodeBtn_Click"/>
                                        <Button x:Name="ToggleCodeBtn" DockPanel.Dock="Right" Content="Show" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="ToggleFriendCodeBtn_Click"/>
                                        <TextBox x:Name="ProfileFriendCodeBox" IsReadOnly="True" FontFamily="Consolas" FontWeight="Bold" Foreground="#FB923C"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Add Friend by Code" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AddFriendCodeBox" Grid.Column="0" ToolTip="Friend Code (e.g. GH3-1234-ABCD)"/>
                                    <TextBox x:Name="AddFriendNameBox" Grid.Column="2" ToolTip="Friend Nickname"/>
                                    <Button Grid.Column="4" Content="+ Add Friend" Style="{StaticResource GreenButton}" Click="AddFriendBtn_Click"/>
                                </Grid>
                                <TextBlock Text="Left: Friend Code (e.g. GH3-6475-71AF)  •  Right: Nickname" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="FriendsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 5: P2P SYNC & LOBBY ==================== -->
                    <StackPanel x:Name="PageP2P" Visibility="Collapsed">
                        <TextBlock Text="P2P Sync &amp; Lobby Setlist" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Sync your active Lobby Setlist (up to 10 songs by default) with friends so large libraries never flood their hard drive."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <!-- Network + Lobby Cap Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="P2pNetworkSummary" Text="Detecting Public IP &amp; UPnP NAT Mapping..." FontSize="13" FontWeight="Bold" Foreground="#60A5FA"/>
                                    <TextBlock x:Name="P2pPinSummary" Text="Session Pairing PIN: ------" FontSize="12" Foreground="#FCD34D" FontFamily="Consolas" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="My Lobby Auto-Sync Cap:" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="LobbyCapBox" Width="56" Text="10" Padding="6,3"/>
                                        <Button Content="Update Cap" Style="{StaticResource OutlineButton}" Padding="9,4" Margin="6,0,0,0" Click="SaveLobbyCapBtn_Click"/>
                                        <TextBlock x:Name="P2pMyLobbyCount" Text="  (0 / 10 songs tagged in My Customs)" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh NAT / UPnP" Style="{StaticResource OutlineButton}" VerticalAlignment="Center" Click="RefreshNatBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Connect to Peer Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Connect to Friend" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Peer Address (IP:Port or DDNS)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PeerAddressBox" Text="127.0.0.1:7373"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Session PIN or Trust Token" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PeerPinBox"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Compare Libraries" Style="{StaticResource FlameButton}" VerticalAlignment="Bottom" Click="ComparePeerBtn_Click"/>
                                </Grid>

                                <!-- Lobby Readiness Banner + Auto-Sync Action -->
                                <Border x:Name="LobbyMatchBanner" Visibility="Collapsed" CornerRadius="8" Padding="12" Margin="0,8,0,0" Background="#0D221A" BorderBrush="#10B981" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LobbyMatchTitle" Text="100% Lobby Matched — Ready for Online Match!" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                                            <TextBlock x:Name="LobbyMatchSub" Text="" FontSize="12" Foreground="#A7F3D0" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ShowFullPeerLibChk" Content="Browse Full Library" Margin="0,0,12,0" Checked="ShowFullPeerLib_Changed" Unchecked="ShowFullPeerLib_Changed"/>
                                            <Button x:Name="AutoSyncLobbyBtn" Content="Auto-Sync Lobby Setlist" Style="{StaticResource GreenButton}" Click="AutoSyncLobbyBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="PeerCompareStatus" Text="" FontSize="12" Foreground="#94A3B8" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="PeerSongsPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 6: IMPORT & CONVERT ==================== -->
                    <StackPanel x:Name="PageImport" Visibility="Collapsed">
                        <TextBlock Text="Import &amp; Convert Songs" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Convert Clone Hero / YARG folders &amp; ZIPs directly into BetterGH3, or import .gh3pack / .gh3song archives."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <!-- 1-Click Clone Hero Converter Card -->
                        <Border Style="{StaticResource GhCard}" BorderBrush="#F97316">
                            <StackPanel>
                                <TextBlock Text="Clone Hero / YARG Converter (1-Click)" FontSize="16" FontWeight="Bold" Foreground="#FB923C" Margin="0,0,0,6"/>
                                <TextBlock Text="Select any Clone Hero song folder or .zip (containing song.ini + notes.chart/.mid + .ogg/.mp3 stems). GH3-Sync automatically maps all stems and compiles straight into Guitar Hero III."
                                           FontSize="12.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Import Clone Hero Folder..." Style="{StaticResource FlameButton}" Margin="0,0,10,0" Click="ImportCloneHeroFolderBtn_Click"/>
                                    <Button Content="Import Clone Hero .zip..." Style="{StaticResource OutlineButton}" Click="ImportCloneHeroZipBtn_Click"/>
                                </StackPanel>
                                <ProgressBar x:Name="ChImportProgress" Visibility="Collapsed" Height="9" Margin="0,12,0,0"/>
                                <TextBlock x:Name="ChImportStatusText" Text="" FontSize="12.5" Foreground="#34D399" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Standard GH3 Archive Import Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="GH3-Sync Archives (.gh3pack, .gh3song, .sgh)" FontSize="15.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                <TextBlock Text="Install pre-compiled custom song packages or export your library."
                                           FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Select Archive &amp; Import..." Style="{StaticResource GreenButton}" Click="ImportArchiveBtn_Click"/>
                                    <Button Content="Export Full Library (.gh3pack)" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="ExportAllPack_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ImportStatusText" Text="" FontSize="12.5" Foreground="#34D399" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 7: CAREER SAVES ==================== -->
                    <StackPanel x:Name="PageSaves" Visibility="Collapsed">
                        <TextBlock Text="Career Saves &amp; Profile Snapshots" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                        <!-- Clear Honest GH3 Save Warning Banner -->
                        <Border Background="#2A1614" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="IMPORTANT: Guitar Hero III Save Compatibility Warning" FontSize="14" FontWeight="Bold" Foreground="#FCA5A5"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="#FECACA" Margin="0,5,0,0" LineHeight="19">
                                    Guitar Hero III ties your career save file (s000.d) directly to your current DATA\customs.pak.xen song list. Whenever you compile or sync new custom songs, GH3 will prompt you to delete/recreate your save file on next launch.&#x0a;
                                    • Restoring a Profile Snapshot below restores BOTH your career save AND its matching customs.pak.xen cleanly (no corrupt-save error), rolling your custom song list back to that snapshot.&#x0a;
                                    • Tip: Save a named "Main Career" snapshot before adding customs, batch-compile new songs together, or use BetterGH3's in-game "Unlock All" option after creating a fresh profile.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Create Named Snapshot Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Save Named Career + Setlist Profile" FontSize="13.5" FontWeight="Bold" Foreground="White" Margin="0,0,0,6"/>
                                    <TextBox x:Name="SaveProfileNameBox" Text="Main Career"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Save Profile Snapshot" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Click="BackupSaveNowBtn_Click"/>
                                    <Button Content="Restore Latest" Style="{StaticResource GreenButton}" Click="RestoreLatestSaveBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="SaveBackupsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 8: ABOUT, LOGS & CREDITS ==================== -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="About GH3-Sync" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                        <!-- Developer & Updates Card -->
                        <Border Style="{StaticResource GhCard}" BorderBrush="#F59E0B">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GH3-Sync v1.0.0 — Created by Mad Scientist" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                        <TextBlock Text="GitHub: " FontSize="12.5" Foreground="#94A3B8"/>
                                        <TextBlock FontSize="12.5">
                                            <Hyperlink NavigateUri="https://github.com/tbailey639" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#FB923C">github.com/tbailey639 (tbailey639)</Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="  •  " FontSize="12.5" Foreground="#64748B"/>
                                        <TextBlock FontSize="12.5">
                                            <Hyperlink NavigateUri="https://github.com/tbailey639/GH3-Sync" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#60A5FA">GH3-Sync Repository</Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock x:Name="AboutUpdateStatus" Text="Version 1.0.0" FontSize="12" Foreground="#CBD5E1"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Check for Updates" Style="{StaticResource FlameButton}" VerticalAlignment="Center" Click="CheckUpdatesBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Credits Card -->
                        <Border Style="{StaticResource GhCard}" Background="#0D1D18" BorderBrush="#10B981">
                            <StackPanel>
                                <TextBlock Text="Credits &amp; Open-Source Acknowledgments" FontSize="15.5" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#D1FAE5" FontSize="12.5" LineHeight="21">
                                    • Honeycomb-GUI &amp; GH-Toolkit-Core — AddyMills &amp; the Neversoft modding community (PAK/QB compilation &amp; checksum tables)&#x0a;
                                    • Demucs (htdemucs_6s) — Alexandre Défossez et al., Meta AI Research (6-stem audio separation)&#x0a;
                                    • Basic Pitch — Spotify Audio Intelligence Lab (polyphonic pitch-to-MIDI transcription)&#x0a;
                                    • BetterGH3 — Marchello &amp; the BetterGH3 Team (Guitar Hero III PC mod &amp; online multiplayer)&#x0a;
                                    • Neversoft Entertainment &amp; Activision — Guitar Hero III: Legends of Rock&#x0a;
                                    • FFmpeg, FMOD/FSB Tools, NAudio (Mark Heath), DryWetMidi (Maxim Dobroselsky), Python-Build-Standalone (Astral)&#x0a;
                                    • Licensed under PolyForm Noncommercial License 1.0.0
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Known Limitations Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Known Limitations" FontSize="15" FontWeight="Bold" Foreground="#FB923C" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12.5" LineHeight="20">
                                    • Modifying custom songs updates DATA\customs.pak.xen, which causes Guitar Hero III to prompt for a save reset on next launch (use paired Career Save snapshots to switch cleanly).&#x0a;
                                    • Optional Demucs 6-Stem + Basic Pitch stem tools require ~700 MB – 1.2 GB of disk space when installed.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Diagnostic Logs -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="Refresh Logs" Style="{StaticResource OutlineButton}" Padding="10,4" Click="RefreshLogsBtn_Click"/>
                                    <TextBlock Text="Diagnostic Logs" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox x:Name="LogsViewerBox" Height="200" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#07080C" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ==================== BUILT-IN AUDIO & STEM PREVIEW BAR ==================== -->
        <Border x:Name="AudioPlayerBar" Grid.Row="4" Visibility="Collapsed"
                Background="#11141E" BorderBrush="#F97316" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayerPlayPauseBtn" Content="⏸" Style="{StaticResource FlameButton}" Padding="10,5" Margin="0,0,6,0" Click="PlayerPlayPauseBtn_Click"/>
                    <Button Content="⏹" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,12,0" Click="PlayerStopBtn_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="PlayerTrackTitle" Text="Previewing..." FontSize="12.5" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PlayerTimeText" Text="0:00 / 0:00" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                </StackPanel>

                <Slider x:Name="PlayerSeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                        PreviewMouseLeftButtonUp="PlayerSeekSlider_MouseUp"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="PlayerStemToggleBtn" Content="Solo Guitar Stem" Style="{StaticResource OutlineButton}" Padding="9,4" Margin="0,0,6,0" Visibility="Collapsed" Click="PlayerStemToggleBtn_Click"/>
                    <Button x:Name="PlayerSetPreviewBtn" Content="Set Preview Start Here" Style="{StaticResource GreenButton}" Padding="10,4" Margin="0,0,6,0" Click="PlayerSetPreviewBtn_Click"/>
                    <Button Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4" Click="PlayerCloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
