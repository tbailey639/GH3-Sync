<Window x:Class="GH3_Sync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GH3_Sync.Views"
        Title="GH3-Sync"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1360" Height="880"
        MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgStage}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml"/>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Animated 5-Fret Energy Accent Strip -->
        <Grid Grid.Row="0" ClipToBounds="True">
            <Border Background="{DynamicResource FretBarGradient}"/>
            <Border x:Name="TopFretShimmer" Width="280" HorizontalAlignment="Left" Opacity="0.65">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#CCFFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TopFretShimmerX" X="-300"/>
                </Border.RenderTransform>
            </Border>
        </Grid>

        <!-- ==================== TOP HEADER BAR ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/gh3_sync_logo.png"
                           Width="40" Height="40" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GH3" FontSize="21" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="-SYNC" FontSize="21" FontWeight="Black" Foreground="{DynamicResource FlameGradient}"/>
                            <Border Background="{DynamicResource VersionBadgeBg}" BorderBrush="{DynamicResource VersionBadgeBorder}" BorderThickness="1" CornerRadius="5" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderVersionBadge" Text="v1.4.0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Guitar Hero III Companion  •  Encore &amp; Zero-Trust Edition  •  by Mad Scientist" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Actions + Animated GH3 Rock Meter -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Iconic GH3 Rock Meter Gauge -->
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="12" Padding="8,3" Margin="0,0,10,0" VerticalAlignment="Center"
                            ToolTip="GH3 Rock Meter — reflects BetterGH3 health, library readiness &amp; pulses to preview audio">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Canvas x:Name="RockMeterCanvas" Width="54" Height="30" Margin="0,0,6,0">
                                <!-- Red / Yellow / Green GH3 Gauge Arcs -->
                                <Path Data="M 5,26 A 22,22 0 0 1 17,7" Stroke="#EF4444" StrokeThickness="4.5" StrokeStartLineCap="Round"/>
                                <Path Data="M 19,6 A 22,22 0 0 1 35,6" Stroke="#EAB308" StrokeThickness="4.5"/>
                                <Path Data="M 37,7 A 22,22 0 0 1 49,26" Stroke="#22C55E" StrokeThickness="4.5" StrokeEndLineCap="Round"/>
                                <!-- Animated Needle -->
                                <Line x:Name="RockMeterNeedle" X1="27" Y1="26" X2="27" Y2="8" Stroke="#F8FAFC" StrokeThickness="2.2" StrokeEndLineCap="Round">
                                    <Line.RenderTransform>
                                        <RotateTransform x:Name="RockMeterNeedleRotate" Angle="38" CenterX="27" CenterY="26"/>
                                    </Line.RenderTransform>
                                </Line>
                                <Ellipse Canvas.Left="23.5" Canvas.Top="22.5" Width="7" Height="7" Fill="#F97316" Stroke="#F8FAFC" StrokeThickness="1.2"/>
                            </Canvas>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ROCK METER" FontSize="8.5" FontWeight="ExtraBold" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="RockMeterStateText" Text="GREEN" FontSize="10.5" FontWeight="Black" Foreground="#22C55E"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="GameStatusPill" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}" BorderThickness="1"
                            CornerRadius="16" Padding="11,5" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
                            <TextBlock x:Name="GameStatusText" Text="BetterGH3 Ready" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CardSuccessTitle}"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="StreamerPrivacyBtn" Content="👁 Privacy" Style="{StaticResource OutlineButton}" Padding="10,7" Margin="0,0,6,0" Click="StreamerPrivacyBtn_Click" ToolTip="Streamer Privacy Mode — instantly hides IPs, PINs, Friend Codes &amp; Tunnel URLs on screen"/>
                    <Button x:Name="QuickPaletteBtn" Content="⚡ Ctrl+K" Style="{StaticResource OutlineButton}" Padding="10,7" Margin="0,0,6,0" Click="QuickPaletteBtn_Click" ToolTip="Open Spotlight Quick-Command Palette (Ctrl+K)"/>
                    <Button Content="▶ Launch GH3" Style="{StaticResource GreenButton}" Padding="13,7" Margin="0,0,8,0" Click="LaunchGh3Btn_Click"/>
                    <Button x:Name="HeaderUpdateBtn" Content="Check Updates" Style="{StaticResource OutlineButton}" Click="CheckUpdatesBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== UPDATE BANNER ==================== -->
        <Border x:Name="UpdateBanner" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource CardWarnBg}" BorderBrush="{DynamicResource CardWarnBorder}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerTitle" Text="Update available" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource CardWarnTitle}"/>
                    <TextBlock x:Name="UpdateBannerSubtitle" Text="Click Update Now to download and install." FontSize="12" Foreground="{DynamicResource CardWarnFg}" Margin="0,2,0,0"/>
                    <ProgressBar x:Name="UpdateBannerProgress" Visibility="Collapsed" Height="8" Margin="0,8,16,0" Minimum="0" Maximum="100"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNowBtn" Content="Update Now" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Click="UpdateNowBtn_Click"/>
                    <Button Content="✕" Style="{StaticResource OutlineButton}" Padding="10,6" Click="DismissUpdateBanner_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN BODY ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Margin="10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="SidebarProfileName" Text="Player" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SidebarFriendCode" Text="GH3-XXXX-XXXX" FontSize="11.5" Foreground="{DynamicResource AccentFlameText}" FontFamily="Consolas" Margin="0,2,0,4"/>
                                <TextBlock x:Name="SidebarLobbySummary" Text="Lobby Auto-Sync: 0 / 10" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="SidebarP2pModeText" Text="P2P Sharing: Online" FontSize="10.5" Foreground="{DynamicResource CardSuccessTitle}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Iconic GH3 Streak Multiplier Ring -->
                            <Border x:Name="SidebarMultiplierRing" Grid.Column="1" Width="40" Height="40" CornerRadius="20"
                                    Background="#182235" BorderBrush="#38BDF8" BorderThickness="2" VerticalAlignment="Center" Margin="6,0,0,0"
                                    ToolTip="GH3 Streak Multiplier — climbs as you install customs, ready BetterGH3 &amp; go online!">
                                <TextBlock x:Name="SidebarMultiplierText" Text="4x" FontSize="13" FontWeight="Black" Foreground="#7DD3FC"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="LIBRARY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSectionHeader}" Margin="18,6,0,6"/>
                            <RadioButton x:Name="NavCustoms" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#22C55E" Stroke="#DCFCE7" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="My Customs"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavCreator" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#EF4444" Stroke="#FEE2E2" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="ONOGAMI Song Creator"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAiTools" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#EAB308" Stroke="#FEF9C3" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="Tools &amp; Stems"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="MULTIPLAYER" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSectionHeader}" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavFriends" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#3B82F6" Stroke="#DBEAFE" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="Friends &amp; Trust"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavP2P" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#F97316" Stroke="#FFEDD5" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="P2P Sync &amp; Lobby"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavImport" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#22C55E" Stroke="#DCFCE7" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="Import &amp; Convert"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="SYSTEM" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSectionHeader}" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavSaves" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#3B82F6" Stroke="#DBEAFE" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="Career Saves"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="#F97316" Stroke="#FFEDD5" StrokeThickness="1" Margin="0,0,9,0"/>
                                    <TextBlock Text="Settings &amp; Security"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CONTENT PAGES + AMBIENT STAGE SPOTLIGHTS -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <!-- Drifting Ambient Concert Stage Spotlights (toggleable via UI Animations setting) -->
                <Canvas x:Name="StageSpotlightOverlay" IsHitTestVisible="False" Opacity="0.34">
                    <Ellipse x:Name="StageSpot1" Width="520" Height="520" Canvas.Left="60" Canvas.Top="-140">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#44F97316" Offset="0"/>
                                <GradientStop Color="#00F97316" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse x:Name="StageSpot2" Width="540" Height="540" Canvas.Left="520" Canvas.Top="240">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#383B82F6" Offset="0"/>
                                <GradientStop Color="#003B82F6" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>
                <!-- Rising "Lou's Inferno" Concert Stage Embers & Floating 5-Fret Sparks -->
                <Canvas x:Name="StageEmbersCanvas" IsHitTestVisible="False" Opacity="0.72"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                    <Grid>

                    <!-- ==================== PAGE 1: MY CUSTOMS ==================== -->
                    <StackPanel x:Name="PageCustoms">
                        <views:StageHudProgressControl x:Name="PageCustoms_StageHud" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CustomsHeaderTitle" Text="Installed Custom Songs" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="CustomsGamePathLabel" Text="Scanning library..." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Refresh" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="RefreshSongs_Click" ToolTip="F5"/>
                                <Button x:Name="TournamentBracketBtn" Content="🏆 Tournament" Style="{StaticResource GoldButton}" Padding="10,6" Margin="0,0,6,0" Click="TournamentBracketBtn_Click" ToolTip="Generate Rock Tour Tournament Bracket (4/8/16 players, song vetoes, match scorecards)"/>
                                <Button x:Name="BossBattleModalBtn" Content="⚡ Boss Duel" Style="{StaticResource PurpleButton}" Padding="10,6" Margin="0,0,6,0" Click="BossBattleModalBtn_Click" ToolTip="Generate GH3 Boss Battle Duel with authentic battle power-up gems!"/>
                                <Button x:Name="SpinRouletteBtn" Content="🎰 Roulette" Style="{StaticResource BlueButton}" Padding="10,6" Margin="0,0,6,0" Click="SpinRouletteBtn_Click" ToolTip="Spin Encore Roulette to pick a random song!"/>
                                <Button x:Name="ExportPosterBtn" Content="🖼 Setlist Poster" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="ExportSetlistPosterBtn_Click" ToolTip="Export a high-res Concert Tour Poster PNG for Discord"/>
                                <Button x:Name="VolumeSoundcheckBtn" Content="🔊 Soundcheck" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="VolumeSoundcheckBtn_Click" ToolTip="Scan &amp; batch-normalize existing custom songs to -14 LUFS"/>
                                <Button x:Name="AutoHealLibraryBtn" Content="🩺 Auto-Heal" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="AutoHealLibraryBtn_Click" ToolTip="Scan customs.pak.xen, soundbanks &amp; plugins and auto-heal issues"/>
                                <Button x:Name="BulkEditBtn" Content="✏️ Bulk Edit" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="BulkEditBtn_Click" ToolTip="Batch-edit Genre, Year, Charter, Volume &amp; Venue across checked songs"/>
                                <Button x:Name="MedleyBuilderBtn" Content="🎸 Medley" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="MedleyBuilderBtn_Click" ToolTip="Stitch 2–4 checked songs into a single playable Live Concert Medley!"/>
                                <Button x:Name="CompareChartsBtn" Content="⚖️ Scorecard" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="CompareChartsBtn_Click" ToolTip="Compare Chart Quality Scorecards (Grade S-C, Peak NPS, HOPO%, Chords, GH3 Venue Tier)"/>
                                <Button x:Name="CalibrateLagBtn" Content="🎯 Calibrate" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="CalibrateLagBtn_Click" ToolTip="Launch GH3 Audio/Video Lag Calibration Mini-Game"/>
                                <Button x:Name="TrophiesWallBtn" Content="🏆 Trophies" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="TrophiesWallBtn_Click" ToolTip="View Legends of Rock Lifetime Stats &amp; Trophies Wall"/>
                                <Button x:Name="SongRequestsBtn" Content="🎤 Requests" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="SongRequestsBtn_Click" ToolTip="Open Streamer !sr Song Request Queue"/>
                                <Button x:Name="CopyDiscordSetlistBtn" Content="📋 Discord" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="CopyDiscordSetlistBtn_Click" ToolTip="Copy Discord-formatted setlist with tiers, high scores &amp; stars"/>
                                <Button x:Name="CopyObsOverlayBtn" Content="📺 OBS Overlay" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="CopyObsOverlayBtn_Click" ToolTip="Copy local OBS Studio Browser Source URL (http://127.0.0.1:7373/obs-overlay)"/>
                                <Button x:Name="ExportLobbyPackBtn" Content="Export Lobby" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="ExportLobbyPack_Click"/>
                                <Button x:Name="ExportSelectedBtn" Content="Selected (0)" Style="{StaticResource OutlineButton}" Padding="10,6" Margin="0,0,6,0" Click="ExportSelectedPack_Click"/>
                                <Button Content="Export All" Style="{StaticResource FlameButton}" Padding="11,6" Click="ExportAllPack_Click"/>
                            </WrapPanel>
                        </Grid>

                        <!-- Filter, Sort & Search Bar -->
                        <Border Style="{StaticResource GhCard}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FilterAllBtn" Content="All" Style="{StaticResource FlameButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="all"/>
                                    <Button x:Name="FilterCreatedBtn" Content="Made with Creator" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="created"/>
                                    <Button x:Name="FilterSyncedBtn" Content="Synced / Imported" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="synced"/>
                                    <Button x:Name="FilterFavBtn" Content="★ Favorites" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="favorites"/>
                                    <Button x:Name="FilterLobbyBtn" Content="Lobby Setlist (0/10)" Style="{StaticResource OutlineButton}" Padding="11,6" Click="FilterSongs_Click" Tag="lobby"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="CompactViewBtn" Content="☰ Compact" Style="{StaticResource OutlineButton}" Padding="8,5" Margin="0,0,6,0" Click="CompactViewBtn_Click" ToolTip="Toggle Compact Setlist vs Full Visual Cards"/>
                                    <ComboBox x:Name="GroupByCombo" Width="118" Margin="0,0,6,0" SelectionChanged="GroupByCombo_SelectionChanged" SelectedIndex="0" ToolTip="Group library by Artist or 8-Tier GH3 Venue Tour">
                                        <ComboBoxItem Content="Group: None"/>
                                        <ComboBoxItem Content="Group: Artist"/>
                                        <ComboBoxItem Content="Group: GH3 Tour"/>
                                    </ComboBox>
                                    <ComboBox x:Name="TagFilterCombo" Width="105" Margin="0,0,6,0" SelectionChanged="TagFilterCombo_SelectionChanged" SelectedIndex="0" ToolTip="Filter by custom song tag">
                                        <ComboBoxItem Content="All Tags"/>
                                        <ComboBoxItem Content="Warmup"/>
                                        <ComboBoxItem Content="Shred"/>
                                        <ComboBoxItem Content="Party"/>
                                        <ComboBoxItem Content="Chill"/>
                                        <ComboBoxItem Content="Co-Op"/>
                                        <ComboBoxItem Content="Live"/>
                                    </ComboBox>
                                    <ComboBox x:Name="SongSortCombo" Width="120" Margin="0,0,6,0" SelectionChanged="SongSortCombo_SelectionChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Sort: Title A-Z"/>
                                        <ComboBoxItem Content="Sort: Artist A-Z"/>
                                        <ComboBoxItem Content="Sort: Newest"/>
                                        <ComboBoxItem Content="Sort: Largest"/>
                                    </ComboBox>
                                    <TextBox x:Name="SongSearchBox" Width="170" TextChanged="SongSearchBox_TextChanged" ToolTip="Search title, artist, or song ID (Ctrl+F)"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Setlist Presets & Party Shuffle Bar -->
                        <Border Style="{StaticResource GhCard}" Padding="10,8" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SavePresetBtn" Content="+ Save Lobby Preset" Style="{StaticResource OutlineButton}" Padding="10,5" Margin="0,0,6,0" Click="SaveSetlistPresetBtn_Click" ToolTip="Save your current Lobby Setlist as a reusable named preset"/>
                                    <Button x:Name="DeletePresetBtn" Content="Delete Preset" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,6,0" Click="DeleteSetlistPresetBtn_Click"/>
                                    <Button x:Name="ShuffleLobbyBtn" Content="🎲 Shuffle Party Setlist" Style="{StaticResource BlueButton}" Padding="11,5" Click="ShuffleLobbySetlistBtn_Click" ToolTip="Pick random installed songs for an instant multiplayer party setlist"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Setlist Presets:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="SetlistPresetCombo" Width="210" SelectionChanged="SetlistPresetCombo_SelectionChanged" ToolTip="Load a saved Lobby Setlist preset in 1 click"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Active Temporary Session Notice on Customs Page -->
                        <Border x:Name="CustomsTempSessionBanner" Visibility="Collapsed"
                                Background="{DynamicResource CardInfoBg}" BorderBrush="{DynamicResource CardInfoBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CustomsTempSessionText" Text="Temporary Lobby Session active." FontSize="12.5" Foreground="{DynamicResource CardInfoFg}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⭐ Keep All Synced Songs" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Padding="12,6" Click="KeepAllTempSongsBtn_Click" ToolTip="Permanently save all songs synced during this session so they are never removed"/>
                                    <Button Content="End Session &amp; Clean Up" Style="{StaticResource DangerButton}" Padding="12,6" Click="EndTempSessionBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Tip: Drag and drop any .gh3song, .gh3pack, Clone Hero .sng/.zip/folder, or audio file directly onto this window."
                                   FontSize="11.5" Foreground="{DynamicResource TextSectionHeader}" Margin="2,-4,0,10"/>

                        <StackPanel x:Name="SongsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 2: SONG CREATOR ==================== -->
                    <StackPanel x:Name="PageCreator" Visibility="Collapsed">
                        <views:StageHudProgressControl x:Name="PageCreator_StageHud" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock Text="ONOGAMI Song Creator" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Create custom songs with dynamic beat tracking, pitch-mapped charting, stem separation, and batch compilation."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,14"/>

                        <!-- Compiler & Auto-Install Bar -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Song Compiler" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CardSuccessTitle}"/>
                                        <Border Background="#064E3B" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorCompilerBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#6EE7B7"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorCompilerMsg" Text="Compiles .pak.xen chart and .fsb.xen audio soundbanks directly into Guitar Hero III."
                                               FontSize="12" Foreground="{DynamicResource CardSuccessFg}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CrAutoCompileChk" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                          Content="Auto-Compile &amp; Install into Game" Foreground="{DynamicResource CardSuccessTitle}" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Stem Separator Bar -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource CardInfoBg}" BorderBrush="{DynamicResource CardInfoBorder}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Multi-Track Stem Separation (Demucs 6-Stem + Basic Pitch)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CardInfoTitle}"/>
                                        <Border x:Name="CreatorAiBadgeBorder" Background="#1E3A8A" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorAiBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#BFDBFE"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorAiMsg" Text="Isolates Guitar, Bass, Drums, Vocals &amp; Piano for mute-on-miss gameplay and cleaner note transcription."
                                               FontSize="12" Foreground="{DynamicResource CardInfoFg}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CrSeparateStemsChk" IsChecked="True" Content="Separate Stems" Foreground="{DynamicResource CardInfoTitle}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <Button x:Name="CreatorQuickInstallAiBtn" Content="Install Stem Tools" Style="{StaticResource BlueButton}" Padding="12,6" Click="GoToAiManager_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Community Handcrafted Chart Search (Chorus Encore) -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource AccentFlame}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="1-Click Handcrafted Community Charts (Chorus Encore)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Search community charts • Or auto-generate below" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel>
                                    <Button x:Name="CommunitySearchBtn" DockPanel.Dock="Right" Content="Search Charts" Style="{StaticResource FlameButton}" Padding="14,6" Margin="8,0,0,0" Click="CommunitySearchBtn_Click"/>
                                    <TextBox x:Name="CommunitySearchBox" KeyDown="CommunitySearchBox_KeyDown" ToolTip="Search song title or artist"/>
                                </DockPanel>
                                <!-- Smart Filters Row -->
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="CommunityFullDiffsOnlyChk" Content="Full Difficulties Only (Easy–Expert)" Margin="0,0,14,0" VerticalAlignment="Center" Checked="CommunityFilter_Changed" Unchecked="CommunityFilter_Changed"/>
                                        <CheckBox x:Name="CommunityClassicFretsChk" Content="Classic 5-Fret GH3 (Convert Open Notes)" VerticalAlignment="Center" Checked="CommunityClassicFretsChk_Changed" Unchecked="CommunityClassicFretsChk_Changed" ToolTip="Converts Clone Hero purple open-strum bars into classic green notes"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CommunitySortCombo" DockPanel.Dock="Right" Width="155" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CommunitySortCombo_SelectionChanged">
                                        <ComboBoxItem Content="Sort: Best Match"/>
                                        <ComboBoxItem Content="Sort: Most Notes"/>
                                        <ComboBoxItem Content="Sort: Difficulty"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock x:Name="CommunitySearchStatus" Text="" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                <ProgressBar x:Name="CommunityInstallProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="CommunityResultsScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel x:Name="CommunityResultsPanel"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Main Form Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Chart Mode" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="ModeAutoGenRadio" Content="Auto-Generate Chart from Audio" Foreground="{DynamicResource TextPrimary}" FontSize="13" IsChecked="True" Margin="0,0,24,0" Checked="ChartMode_Changed"/>
                                    <RadioButton x:Name="ModeUploadRadio" Content="Use Existing Chart / MIDI (.chart or .mid)" Foreground="{DynamicResource TextPrimary}" FontSize="13" Checked="ChartMode_Changed"/>
                                </StackPanel>

                                <!-- File Pickers -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Audio File (.mp3, .wav, .ogg) *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="▶ Preview" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="PreviewCreatorAudioBtn_Click"/>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="BrowseAudioBtn_Click"/>
                                            <TextBox x:Name="CrAudioPathBox" IsReadOnly="True"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="ChartPickerPanel" Grid.Column="2" Visibility="Collapsed">
                                        <TextBlock Text="Chart / MIDI File (.chart or .mid) *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="BrowseChartBtn_Click"/>
                                            <TextBox x:Name="CrChartPathBox" IsReadOnly="True"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="BpmPickerPanel" Grid.Column="2">
                                        <DockPanel Margin="0,0,0,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button x:Name="TapTempoBtn" Content="Tap Tempo" Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="11" Margin="0,0,5,0" Click="TapTempoBtn_Click" ToolTip="Tap along with the beat (click or press Space) to lock exact BPM"/>
                                                <Button Content="Detect BPM" Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="11" Click="DetectBpmBtn_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Tempo (BPM)" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="BpmStatusLabel" DockPanel.Dock="Right" Text="" FontSize="11.5" Foreground="{DynamicResource CardSuccessTitle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBox x:Name="CrBpmBox" Text="130"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Optional URL Audio Importer (yt-dlp) + Metadata Auto-Fetcher -->
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="FetchCreatorMetaBtn" DockPanel.Dock="Right" Content="🎨 Fetch Cover Art &amp; Tags" Style="{StaticResource OutlineButton}" Padding="10,5" Margin="8,0,0,0" Click="FetchCreatorMetaBtn_Click" ToolTip="Auto-lookup high-res album art, Album Name, Year, and Genre"/>
                                    <Button x:Name="UrlImportBtn" DockPanel.Dock="Right" Content="⬇ Grab Audio URL" Style="{StaticResource BlueButton}" Padding="11,5" Margin="8,0,0,0" Click="UrlImportBtn_Click" ToolTip="Paste a YouTube / SoundCloud / audio URL (uses optional managed yt-dlp add-on)"/>
                                    <TextBox x:Name="UrlImportBox" ToolTip="Optional: paste a song URL here and click 'Grab Audio URL'"/>
                                </DockPanel>

                                <!-- Interactive 3-Cover Artwork Carousel Picker -->
                                <Border x:Name="CrArtCarouselContainer" Visibility="Collapsed" Margin="0,0,0,14"
                                        Background="{DynamicResource BgCardHover}" BorderBrush="{DynamicResource BorderSubtle}"
                                        BorderThickness="1" CornerRadius="10" Padding="12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock Text="🎨 Cover Art Carousel (Click candidate to select best HD match)"
                                                       FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="CrArtCustomPickBtn" DockPanel.Dock="Right" Content="Browse Local Image..."
                                                    Style="{StaticResource OutlineButton}" Padding="8,3" FontSize="11"
                                                    Click="CrArtCustomPickBtn_Click"/>
                                        </DockPanel>

                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Candidate 1 -->
                                            <Border x:Name="CrArtCard1" Grid.Column="0" Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource AccentFlame}" BorderThickness="1.5"
                                                    CornerRadius="8" Padding="8" Cursor="Hand" MouseLeftButtonDown="CrArtCard1_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="90" Height="90" CornerRadius="6" Background="#0C0A12" ClipToBounds="True">
                                                        <Image x:Name="CrArtImg1" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock x:Name="CrArtLabel1" Text="Candidate 1" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="CrArtSource1" Text="HD Deezer (1000×1000)" FontSize="9.5"
                                                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Candidate 2 -->
                                            <Border x:Name="CrArtCard2" Grid.Column="2" Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5"
                                                    CornerRadius="8" Padding="8" Cursor="Hand" MouseLeftButtonDown="CrArtCard2_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="90" Height="90" CornerRadius="6" Background="#0C0A12" ClipToBounds="True">
                                                        <Image x:Name="CrArtImg2" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock x:Name="CrArtLabel2" Text="Candidate 2" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="CrArtSource2" Text="Apple iTunes (600×600)" FontSize="9.5"
                                                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Candidate 3 -->
                                            <Border x:Name="CrArtCard3" Grid.Column="4" Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1.5"
                                                    CornerRadius="8" Padding="8" Cursor="Hand" MouseLeftButtonDown="CrArtCard3_Click">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="90" Height="90" CornerRadius="6" Background="#0C0A12" ClipToBounds="True">
                                                        <Image x:Name="CrArtImg3" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <TextBlock x:Name="CrArtLabel3" Text="Candidate 3" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,0"
                                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="CrArtSource3" Text="Embedded / MusicBrainz" FontSize="9.5"
                                                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Auto-Chart & Audio Mix Tuning Row -->
                                <Grid x:Name="ChartTuningRow" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Chart Density / Feel" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrFeelCombo" SelectedIndex="1">
                                            <ComboBoxItem Content="Casual"/>
                                            <ComboBoxItem Content="Standard"/>
                                            <ComboBoxItem Content="Shredder"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Playable Instrument Focus (Basic Pitch AI)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrFocusCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Auto (Smart Multi-Lead — Play the Hook)"/>
                                            <ComboBoxItem Content="Lead Guitar (Rock / Metal)"/>
                                            <ComboBoxItem Content="Keys / Synth / Sax (Non-Guitar Melodic)"/>
                                            <ComboBoxItem Content="Groove Bassline"/>
                                            <ComboBoxItem Content="Vocal Melody"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Game Audio Mix Mode" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrAudioMixCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Auto (Recommended — Best for Song Type)"/>
                                            <ComboBoxItem Content="Studio Master (Cleanest Original Audio)"/>
                                            <ComboBoxItem Content="Isolated Lead Stem (Mute-on-Miss)"/>
                                            <ComboBoxItem Content="Hybrid Blend (Studio Clarity + Soft Ducking)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5">
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox x:Name="CrVariableTempoChk" IsChecked="True" Content="Smart Tempo Detection (Studio Constant Grid vs. Live Variable Map)" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CrPreviewStartLabel" Text="Menu Preview Start: 5.0s" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <!-- Audio Mastering: Loudness Norm (-14 LUFS), Trim/Fade, Sync Offset -->
                                        <WrapPanel VerticalAlignment="Center">
                                            <CheckBox x:Name="CrNormalizeLoudnessChk" IsChecked="True" Content="Normalize Volume (-14 LUFS)" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Matches official Guitar Hero III loudness automatically via FFmpeg EBU R128"/>
                                            <CheckBox x:Name="CrFadeOutChk" IsChecked="False" Content="2s Smooth Fade-Out" VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Applies a 2-second fade-out at the Trim Out point"/>
                                            <TextBlock Text="Sync Offset (ms):" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox x:Name="CrOffsetBox" Width="54" Text="0" Padding="5,2" Margin="0,0,14,0" ToolTip="Shift generated notes earlier (negative) or later (positive) in milliseconds"/>
                                            <TextBlock x:Name="CrTrimSummaryText" Text="Trim: Full Track (use ▶ Preview bar to set Trim In/Out)" FontSize="11.5" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Button x:Name="CrResetTrimBtn" Content="Reset Trim" Style="{StaticResource OutlineButton}" Padding="7,2" FontSize="11" Visibility="Collapsed" Click="CrResetTrimBtn_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Metadata Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Song Title *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrTitleBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Artist Name *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrArtistBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Album" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrAlbumBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Year" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrYearBox" Text="2026"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Genre" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrGenreBox" Text="Rock"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="Charter Name" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrCharterBox" Text="Mad Scientist"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Exclusive Enhancements (Stadium Chants, Boss Battle, Charter Signatures) -->
                                <WrapPanel Margin="0,12,0,0">
                                    <CheckBox x:Name="CrStadiumChantsChk" Content="🏟️ AI Stadium Sing-Along &amp; Crowd Chants (Chorus claps)" IsChecked="True" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="CrBossBattleChk" Content="⚡ Boss Battle Duel (Broken String &amp; Double Notes power-ups)" IsChecked="False" Margin="0,0,16,6"/>
                                    <CheckBox x:Name="CrSignCharterChk" Content="🔏 Cryptographic Charter Signature (.gh3sig verified checkmark)" IsChecked="True" Margin="0,0,16,6"/>
                                </WrapPanel>

                                <!-- Actions + Interactive Editable Batch Queue -->
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CreateSongSubmitBtn" Content="Create &amp; Compile Song" Style="{StaticResource FlameButton}" Padding="20,10" FontSize="13.5" Click="CreateSongBtn_Click"/>
                                        <Button x:Name="CreatorPreviewHighwayBtn" Content="🎸 Preview Highway" Style="{StaticResource BlueButton}" Margin="8,0,0,0" Click="CreatorPreviewHighwayBtn_Click" ToolTip="Preview your uploaded or newly generated chart on a live 5-fret highway"/>
                                        <Button x:Name="AddToQueueBtn" Content="+ Add to Batch Queue" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="AddToQueueBtn_Click"/>
                                        <Button x:Name="RunQueueBtn" Content="Compile Batch Queue (0)" Style="{StaticResource GreenButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="RunQueueBtn_Click"/>
                                        <Button x:Name="ClearQueueBtn" Content="Clear Queue" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Visibility="Collapsed" Click="ClearQueueBtn_Click"/>
                                        <TextBlock x:Name="CrProgressLabel" Text="" FontSize="12" Foreground="{DynamicResource CardWarnTitle}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>

                                    <Border x:Name="BatchQueueContainer" Visibility="Collapsed" Margin="0,12,0,0"
                                            Background="{DynamicResource BgCardHover}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock x:Name="BatchQueueHeaderText" Text="Batch Queue (0 songs)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Tip: Click Edit on any song to tweak BPM, Feel, Focus, or Audio Mode individually (or drop multiple MP3s at once)" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <StackPanel x:Name="BatchQueuePanel"/>
                                        </StackPanel>
                                    </Border>

                                    <ProgressBar x:Name="CrProgressBar" Visibility="Collapsed" Height="10" Margin="0,10,0,0" Minimum="0" Maximum="100"/>
                                    <Border x:Name="CrResultBox" Visibility="Collapsed" Margin="0,12,0,0" CornerRadius="8" Padding="12" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}" BorderThickness="1">
                                        <TextBlock x:Name="CrResultText" TextWrapping="Wrap" Foreground="{DynamicResource CardSuccessFg}" FontSize="12.5"/>
                                    </Border>
                                </StackPanel>

                                <!-- GH3 Save Notice -->
                                <Border Background="{DynamicResource CardWarnBg}" BorderBrush="{DynamicResource CardWarnBorder}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,14,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource CardWarnFg}"
                                               Text="Note: The first time custom songs are added to a vanilla GH3 save, Guitar Hero III prompts for a one-time save reset. After that initial custom profile is created, new songs merge into your existing customs.pak.xen cleanly."/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 3: TOOLS & STEMS ==================== -->
                    <StackPanel x:Name="PageAiTools" Visibility="Collapsed">
                        <views:StageHudProgressControl x:Name="PageAiTools_StageHud" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock Text="Tools &amp; Stem Separation" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Manage the song compiler and optional 6-stem separation package." FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,16"/>

                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Honeycomb Compiler &amp; FFmpeg" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock x:Name="AiToolsCompilerPath" Text="Checking..." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock x:Name="AiToolsCompilerStatus" Text="Ready" FontSize="12" FontWeight="Bold" Foreground="#6EE7B7"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GhCard}" BorderBrush="{DynamicResource CardInfoBorder}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Demucs 6-Stem (htdemucs_6s) + Basic Pitch" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource CardInfoTitle}"/>
                                        <TextBlock Text="Separates songs into isolated Guitar, Bass, Drums, Vocals &amp; Piano stems and transcribes guitar MIDI notes. Installs automatically to AppData and is preserved across app updates."
                                                   FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border x:Name="AiStatusPill" Grid.Column="1" Background="#3B2F0C" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="AiStatusPillText" Text="Not Installed" FontSize="12" FontWeight="Bold" Foreground="#FDE047"/>
                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,4,0,14">
                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompDemucs" Text="Demucs 6-Stem: Checking..." FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompBasicPitch" Text="Basic Pitch MIDI: Checking..." FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompSize" Text="Disk Usage: 0 MB" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </Border>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallAiBtn" Content="Install Stem Tools (~700 MB - 1.2 GB)" Style="{StaticResource FlameButton}" Padding="16,9" Click="InstallAiEngineBtn_Click"/>
                                    <Button x:Name="UninstallAiBtn" Content="Uninstall" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="UninstallAiEngineBtn_Click"/>
                                    <Button Content="Open Folder" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="OpenAiFolderBtn_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="AiInstallProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock x:Name="AiInstallStepText" Text="Starting installation..." FontSize="12" Foreground="{DynamicResource CardWarnTitle}" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="AiInstallProgressBar" Height="11" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Optional yt-dlp Audio URL Importer Add-On Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Optional Audio URL Importer (yt-dlp)" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <Border x:Name="YtDlpStatusPill" Background="#3B2F0C" CornerRadius="5" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="YtDlpStatusText" Text="Not Installed" FontSize="11" FontWeight="Bold" Foreground="#FDE047"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Optional standalone tool (~15 MB) stored in AppData. Lets you paste song or live-performance URLs directly into ONOGAMI Song Creator with automatic cover art &amp; title parsing."
                                               FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="InstallYtDlpBtn" Content="Install / Update yt-dlp" Style="{StaticResource BlueButton}" Padding="13,7" Margin="0,0,8,0" Click="InstallYtDlpBtn_Click"/>
                                    <Button x:Name="UninstallYtDlpBtn" Content="Remove" Style="{StaticResource OutlineButton}" Padding="10,7" Visibility="Collapsed" Click="UninstallYtDlpBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 4: FRIENDS & TRUST ==================== -->
                    <StackPanel x:Name="PageFriends" Visibility="Collapsed">
                        <views:StageHudProgressControl x:Name="PageFriends_StageHud" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock Text="Friends" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Add friends with their Friend Code to view online status and 1-click sync custom songs."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,16"/>

                        <!-- User Profile & Friend Code Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <TextBlock Text="Your Display Name" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource FlameButton}" Margin="8,0,0,0" Click="SaveUsernameBtn_Click"/>
                                        <TextBox x:Name="ProfileUsernameBox"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <TextBlock Text="Your Permanent Friend Code" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="📋 Copy Code" Style="{StaticResource FlameButton}" Margin="6,0,0,0" Click="CopyFriendCodeBtn_Click" ToolTip="Copy your Friend Code to share with friends"/>
                                        <Button x:Name="ToggleCodeBtn" DockPanel.Dock="Right" Content="Show" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="ToggleFriendCodeBtn_Click"/>
                                        <TextBox x:Name="ProfileFriendCodeBox" IsReadOnly="True" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                    <DockPanel>
                                        <Button x:Name="PreviewShowcaseBtn" DockPanel.Dock="Right" Content="▶ Preview" Style="{StaticResource BlueButton}" Padding="10,4" Margin="8,0,0,0" Click="PreviewShowcaseBtn_Click"/>
                                        <TextBlock Text="🎸 Signature / Showcase Track:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="ProfileShowcaseCombo" SelectionChanged="ProfileShowcaseCombo_SelectionChanged"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Add Friend Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="🔄 Refresh Status" Style="{StaticResource OutlineButton}" Click="RefreshFriendsBtn_Click"/>
                                    <TextBlock Text="Add a Friend" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                </DockPanel>
                                <TextBlock Text="Enter your friend's Friend Code to send a request:"
                                           FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AddFriendCodeBox" Grid.Column="0" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                             ToolTip="Friend Code (e.g. GH3-5126-A893)" TextChanged="AddFriendCodeBox_TextChanged"/>
                                    <Button x:Name="SendFriendRequestBtn" Grid.Column="2" Content="➕ Add Friend" Style="{StaticResource OutlineButton}"
                                            Padding="14,7" Click="SendFriendRequestBtn_Click" ToolTip="Add as Regular Friend (View Setlist &amp; Presence)"/>
                                    <Button x:Name="SendTrustedFriendRequestBtn" Grid.Column="4" Content="⭐ Add Trusted Friend" Style="{StaticResource FlameButton}"
                                            Padding="16,7" Click="SendTrustedFriendRequestBtn_Click" ToolTip="Add as Trusted Friend (Full Song Download &amp; 1-Click Sync)"/>
                                </Grid>

                                <!-- Live Auto-Detection Status Pill -->
                                <Border x:Name="AutoDetectStatusPill" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
                                        Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1">
                                    <DockPanel>
                                        <TextBlock x:Name="AutoDetectStatusIcon" Text="🔍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="AutoDetectStatusText" Text="Detecting player profile..." FontSize="12" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="FriendsListPanel"/>

                        <!-- Advanced Network / Offline LAN Expander (Collapsed by default) -->
                        <Expander Header="⚙️ Advanced Network Settings (Optional / Offline LAN Only)"
                                  Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,16,0,0" IsExpanded="False">
                            <Border Style="{StaticResource GhCard}" Padding="12" Margin="0,6,0,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Direct Host/IP: " Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="DirectAddressBox" ToolTip="e.g. 192.168.1.50:7373 or my-ddns.org:7373" FontFamily="Consolas"/>
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="FriendsStartTunnelBtn" Content="🌐 Restart Internet Tunnel" Style="{StaticResource BlueButton}" Padding="10,5" Margin="0,0,8,0" Click="FriendsToggleTunnelBtn_Click"/>
                                        <TextBlock x:Name="FriendsTunnelHeadline" Text="Tunnel: Automatic" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="FriendsTunnelStatusIcon" Text="" Visibility="Collapsed"/>
                                        <TextBlock x:Name="FriendsTunnelDetail" Text="" Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>

                    <!-- ==================== PAGE 5: P2P SYNC & LOBBY ==================== -->
                    <StackPanel x:Name="PageP2P" Visibility="Collapsed">
                        <views:StageHudProgressControl x:Name="PageP2P_StageHud" Visibility="Collapsed" Margin="0,0,0,12"/>
                        <TextBlock Text="P2P Sync &amp; Lobby Setlist" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Sync your active Lobby Setlist with your friends before launching into a match."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,16"/>

                        <!-- Active Temporary Session Banner -->
                        <Border x:Name="TempSessionBanner" Visibility="Collapsed"
                                Style="{StaticResource GhCard}" Background="{DynamicResource CardInfoBg}" BorderBrush="{DynamicResource CardInfoBorder}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TempSessionTitle" Text="Temporary Lobby Session Active" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource CardInfoTitle}"/>
                                    <TextBlock x:Name="TempSessionSubtitle" Text="Temporary songs will auto-clean when GH3 exits. Click 'Keep All Synced Songs' to save them permanently."
                                               FontSize="12" Foreground="{DynamicResource CardInfoFg}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="⭐ Keep All Synced Songs" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Padding="14,7" Click="KeepAllTempSongsBtn_Click" ToolTip="Permanently save all songs synced during this session so they are never removed"/>
                                    <Button Content="End Session &amp; Clean Up" Style="{StaticResource DangerButton}" Padding="12,7" Click="EndTempSessionBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- In-Game Multiplayer Custom Song Notice -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource CardWarnBg}" BorderBrush="{DynamicResource CardWarnBorder}" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="💡" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GH3 Online Multiplayer Rule: Both players must have custom songs synced before playing!"
                                               FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CardWarnTitle}"/>
                                    <TextBlock Text="If you pick a custom song your friend doesn't have, GH3 will freeze on the loading screen and auto-play as a bot. Click 'Compare &amp; Sync Songs' on your friend's card below before launching into a match!"
                                               FontSize="11.5" Foreground="{DynamicResource CardWarnFg}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 1-Click Friends in Lobby Card (Option B - HERO ELEMENT) -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource AccentFlame}" BorderThickness="1.5" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Friends in Lobby" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}"/>
                                        <Border Background="#064E3B" CornerRadius="5" Padding="7,2" Margin="10,0,0,0">
                                            <TextBlock Text="🟢 Auto-Discovered" FontSize="11" FontWeight="Bold" Foreground="#6EE7B7"/>
                                        </Border>
                                    </StackPanel>
                                    <Button x:Name="RefreshLobbyFriendsBtn" Content="↻ Refresh Presence" Style="{StaticResource OutlineButton}" Padding="10,4" HorizontalAlignment="Right" Click="RefreshLobbyFriendsBtn_Click"/>
                                </DockPanel>
                                <TextBlock Text="Friends in your circle are automatically detected when their GH3-Sync is open. Click 'Compare &amp; Sync Songs' to view their setlist with zero typing."
                                           FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                <StackPanel x:Name="LobbyFriendsContainer"/>
                            </StackPanel>
                        </Border>

                        <!-- Lobby Settings & Auto-Sync Cap Card -->
                        <Border Style="{StaticResource GhCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Lobby Auto-Sync Cap:" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="LobbyCapBox" Width="52" Text="10" Padding="6,3"/>
                                        <Button Content="Update" Style="{StaticResource OutlineButton}" Padding="9,4" Margin="6,0,0,0" Click="SaveLobbyCapBtn_Click"/>
                                        <TextBlock x:Name="P2pMyLobbyCount" Text="  (0 / 10 songs tagged in My Customs)" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TempSessionModeChk" IsChecked="True" Margin="0,8,0,0"
                                              Content="Temporary Session Mode (auto-clean synced songs when GH3 closes — keep any song anytime)"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button x:Name="SetlistDraftBtn" Content="⚔️ Setlist Draft" Style="{StaticResource BlueButton}" Padding="14,6" Click="SetlistDraftBtn_Click" ToolTip="Launch Head-to-Head Multiplayer Setlist Draft &amp; Match Tracker"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Live Lobby Hype Soundboard over P2P -->
                        <Border Style="{StaticResource GhCard}" BorderBrush="{DynamicResource AccentGold}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="📢 LOBBY HYPE SOUNDBOARD" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentGoldText}"/>
                                    <TextBlock Text="Broadcast live concert SFX to your multiplayer friend in real-time!" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="HypeAirhornBtn" Content="📢 Airhorn" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,6,0" Click="HypeSfx_Click" Tag="airhorn"/>
                                    <Button x:Name="HypeCheerBtn" Content="🏟️ Stadium Cheer" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,6,0" Click="HypeSfx_Click" Tag="cheer"/>
                                    <Button x:Name="HypeBooBtn" Content="👎 Boooo!" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,6,0" Click="HypeSfx_Click" Tag="boo"/>
                                    <Button x:Name="HypeDrumBtn" Content="🥁 Drum Fill" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,6,0" Click="HypeSfx_Click" Tag="drum"/>
                                    <Button x:Name="HypeLightningBtn" Content="⚡ Lightning" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,6,0" Click="HypeSfx_Click" Tag="lightning"/>
                                    <Button x:Name="HypeSoloBtn" Content="🎸 Solo Lick" Style="{StaticResource OutlineButton}" Padding="9,5" Click="HypeSfx_Click" Tag="solo"/>
                                </WrapPanel>
                            </Grid>
                        </Border>

                        <!-- Synchronized Match Ready-Up & Countdown Card -->
                        <Border x:Name="LobbyReadyCard" Style="{StaticResource GhCard}" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource AccentFlame}" BorderThickness="1.5" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Online Match Ready-Up" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <Border x:Name="LocalReadyBadge" Background="#1E293B" CornerRadius="4" Padding="7,2" Margin="10,0,0,0">
                                            <TextBlock x:Name="LocalReadyText" Text="⚪ You: Not Ready" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                        </Border>
                                        <Border x:Name="RemoteReadyBadge" Background="#1E293B" CornerRadius="4" Padding="7,2" Margin="6,0,0,0">
                                            <TextBlock x:Name="RemoteReadyText" Text="⚪ Friend: Waiting" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="LobbyReadySubtitle" Text="When both players Ready Up, GH3-Sync counts down '3... 2... 1... ROCK!' and launches the game together!"
                                               FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="PartyRouletteBtn" Content="🎲 Party Roulette Draft" Style="{StaticResource OutlineButton}" Padding="12,7" Margin="0,0,8,0" Click="PartyRouletteBtn_Click" ToolTip="Synchronously spin a shared random setlist draft with your friend!"/>
                                    <Button x:Name="LobbyReadyBtn" Content="🟢 Ready Up" Style="{StaticResource FlameButton}" Padding="18,7" Click="LobbyReadyBtn_Click" ToolTip="Signal you are ready to play!"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Lobby Readiness Banner + Auto-Sync Action -->
                        <Border x:Name="LobbyMatchBanner" Visibility="Collapsed" CornerRadius="8" Padding="12" Margin="0,0,0,12" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LobbyMatchTitle" Text="100% Lobby Matched — Ready for Online Match!" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CardSuccessTitle}"/>
                                    <TextBlock x:Name="LobbyMatchSub" Text="" FontSize="12" Foreground="{DynamicResource CardSuccessFg}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="FilterMissingOnlyChk" Content="Only Show Songs I Don't Have" Margin="0,0,12,0" Checked="FilterMissingOnly_Changed" Unchecked="FilterMissingOnly_Changed" ToolTip="Hide songs you already have and show only missing tracks to sync"/>
                                    <CheckBox x:Name="ShowFullPeerLibChk" Content="Browse Full Library" Margin="0,0,12,0" Checked="ShowFullPeerLib_Changed" Unchecked="ShowFullPeerLib_Changed"/>
                                    <Button x:Name="AutoSyncLobbyBtn" Content="Auto-Sync Lobby Setlist" Style="{StaticResource GreenButton}" Click="AutoSyncLobbyBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="PeerCompareStatus" Text="" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                        <!-- Peer Songs Comparison Container -->
                        <StackPanel x:Name="PeerSongsPanel"/>

                        <!-- Advanced Network & Direct LAN Expander (Collapsed by default) -->
                        <Expander Header="⚙️ Advanced Network Settings &amp; Direct LAN IP Override (Optional)"
                                  Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,16,0,0" IsExpanded="False">
                            <Border Style="{StaticResource GhCard}" Padding="14" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Network Diagnostic Status" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CardInfoTitle}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="P2pNetworkSummary" Text="Public IP &amp; NAT Status..." FontSize="11.5" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock x:Name="P2pPinSummary" Text="Session Pairing PIN: ------" FontSize="11.5" Foreground="{DynamicResource CardWarnTitle}" FontFamily="Consolas" Margin="0,2,0,4"/>
                                    <TextBlock x:Name="MeshNetworkSummaryText" Text="Mesh Interface Status..." FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,2"/>
                                    <TextBlock x:Name="TunnelStatusText" Text="HTTPS Tunnel Status..." FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button Content="Refresh NAT / UPnP" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,6,0" Click="RefreshNatBtn_Click"/>
                                        <Button x:Name="StartTunnelBtn" Content="🌐 Restart HTTPS Tunnel" Style="{StaticResource BlueButton}" Padding="8,4" Margin="0,0,6,0" Click="ToggleTunnelBtn_Click"/>
                                        <Button Content="Rescan Mesh" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,6,0" Click="RescanMeshBtn_Click"/>
                                        <Button x:Name="CopyLobbyInviteBtn" Content="Copy Invite String" Style="{StaticResource OutlineButton}" Padding="8,4" Margin="0,0,6,0" Click="CopyLobbyInviteBtn_Click"/>
                                        <CheckBox x:Name="ExpiringInviteChk" Content="4-Hour Expiring Token" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="Direct IP / Port Override (For LAN play without internet)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
