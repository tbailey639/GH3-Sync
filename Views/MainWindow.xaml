                                    </Border>
                                </Grid>

                                <WrapPanel Margin="0,4,0,14">
                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompDemucs" Text="Demucs 6-Stem: Checking..." FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompBasicPitch" Text="Basic Pitch MIDI: Checking..." FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </Border>
                                    <Border Background="{DynamicResource BgInput}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompSize" Text="Disk Usage: 0 MB" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                    </Border>
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallAiBtn" Content="Install Stem Tools (~700 MB - 1.2 GB)" Style="{StaticResource FlameButton}" Padding="16,9" Click="InstallAiEngineBtn_Click"/>
                                    <Button x:Name="UninstallAiBtn" Content="Uninstall" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Visibility="Collapsed" Click="UninstallAiEngineBtn_Click"/>
                                    <Button Content="Open Folder" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="OpenAiFolderBtn_Click"/>
                                </StackPanel>

                                <StackPanel x:Name="AiInstallProgressPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                    <TextBlock x:Name="AiInstallStepText" Text="Starting installation..." FontSize="12" Foreground="{DynamicResource CardWarnTitle}" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="AiInstallProgressBar" Height="11" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 4: FRIENDS & TRUST ==================== -->
                    <StackPanel x:Name="PageFriends" Visibility="Collapsed">
                        <TextBlock Text="Friends &amp; Trusted Network" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Only Trusted Friends can download custom songs from your library. Regular friends with a Session PIN can view your setlist only."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,16"/>

                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Display Name" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource FlameButton}" Margin="8,0,0,0" Click="SaveUsernameBtn_Click"/>
                                        <TextBox x:Name="ProfileUsernameBox"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Permanent Friend Code" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="CopyFriendCodeBtn_Click"/>
                                        <Button x:Name="ToggleCodeBtn" DockPanel.Dock="Right" Content="Show" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="ToggleFriendCodeBtn_Click"/>
                                        <TextBox x:Name="ProfileFriendCodeBox" IsReadOnly="True" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Add Friend by Code" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AddFriendCodeBox" Grid.Column="0" ToolTip="Friend Code (e.g. GH3-1234-ABCD)"/>
                                    <TextBox x:Name="AddFriendNameBox" Grid.Column="2" ToolTip="Friend Nickname"/>
                                    <Button Grid.Column="4" Content="+ Add Friend" Style="{StaticResource GreenButton}" Click="AddFriendBtn_Click"/>
                                </Grid>
                                <TextBlock Text="Left: Friend Code (e.g. GH3-6475-71AF)  •  Right: Nickname" FontSize="11" Foreground="{DynamicResource TextSectionHeader}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="FriendsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 5: P2P SYNC & LOBBY ==================== -->
                    <StackPanel x:Name="PageP2P" Visibility="Collapsed">
                        <TextBlock Text="P2P Sync &amp; Lobby Setlist" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Sync your active Lobby Setlist (up to 10 songs by default) with Trusted Friends. Enable Temporary Session Mode to auto-clean synced songs when GH3 closes."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,16"/>

                        <!-- Active Temporary Session Banner -->
                        <Border x:Name="TempSessionBanner" Visibility="Collapsed"
                                Style="{StaticResource GhCard}" Background="{DynamicResource CardInfoBg}" BorderBrush="{DynamicResource CardInfoBorder}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="TempSessionTitle" Text="Temporary Lobby Session Active" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource CardInfoTitle}"/>
                                    <TextBlock x:Name="TempSessionSubtitle" Text="Temporary songs will auto-clean when GH3 exits. Click 'Keep' on any song in My Customs to save it permanently."
                                               FontSize="12" Foreground="{DynamicResource CardInfoFg}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="End Session &amp; Clean Up" Style="{StaticResource DangerButton}" VerticalAlignment="Center" Click="EndTempSessionBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Network + Lobby Cap Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="P2pNetworkSummary" Text="Detecting Public IP &amp; UPnP NAT Mapping..." FontSize="13" FontWeight="Bold" Foreground="{DynamicResource CardInfoTitle}"/>
                                    <TextBlock x:Name="P2pPinSummary" Text="Session Pairing PIN: ------" FontSize="12" Foreground="{DynamicResource CardWarnTitle}" FontFamily="Consolas" Margin="0,4,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="My Lobby Auto-Sync Cap:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="LobbyCapBox" Width="56" Text="10" Padding="6,3"/>
                                        <Button Content="Update Cap" Style="{StaticResource OutlineButton}" Padding="9,4" Margin="6,0,0,0" Click="SaveLobbyCapBtn_Click"/>
                                        <TextBlock x:Name="P2pMyLobbyCount" Text="  (0 / 10 songs tagged in My Customs)" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Refresh NAT / UPnP" Style="{StaticResource OutlineButton}" VerticalAlignment="Center" Click="RefreshNatBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Connect to Peer Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Quick-Select Trusted Friend:" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="TrustedFriendQuickCombo" Width="210" SelectionChanged="TrustedFriendQuickCombo_SelectionChanged"/>
                                    </StackPanel>
                                    <TextBlock Text="Connect to Friend" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Peer Address (IP:Port or DDNS)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PeerAddressBox" Text="127.0.0.1:7373"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Trust Token (Required to Download) or PIN (View Only)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PeerPinBox"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="Compare Libraries" Style="{StaticResource FlameButton}" VerticalAlignment="Bottom" Click="ComparePeerBtn_Click"/>
                                </Grid>

                                <CheckBox x:Name="TempSessionModeChk" IsChecked="True" Margin="0,2,0,4"
                                          Content="Temporary Lobby Session Mode (auto-remove synced songs &amp; restore customs.pak.xen when GH3 closes — keep any song anytime)"/>

                                <!-- Lobby Readiness Banner + Auto-Sync Action -->
                                <Border x:Name="LobbyMatchBanner" Visibility="Collapsed" CornerRadius="8" Padding="12" Margin="0,8,0,0" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="LobbyMatchTitle" Text="100% Lobby Matched — Ready for Online Match!" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CardSuccessTitle}"/>
                                            <TextBlock x:Name="LobbyMatchSub" Text="" FontSize="12" Foreground="{DynamicResource CardSuccessFg}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox x:Name="ShowFullPeerLibChk" Content="Browse Full Library" Margin="0,0,12,0" Checked="ShowFullPeerLib_Changed" Unchecked="ShowFullPeerLib_Changed"/>
                                            <Button x:Name="AutoSyncLobbyBtn" Content="Auto-Sync Lobby Setlist" Style="{StaticResource GreenButton}" Click="AutoSyncLobbyBtn_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="PeerCompareStatus" Text="" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="PeerSongsPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 6: IMPORT & CONVERT ==================== -->
                    <StackPanel x:Name="PageImport" Visibility="Collapsed">
                        <TextBlock Text="Import &amp; Convert Songs" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Convert Clone Hero / YARG folders &amp; ZIPs directly into BetterGH3, or import .gh3pack / .gh3song archives safely into your existing songlist."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,16"/>

                        <!-- 1-Click Clone Hero Converter Card -->
                        <Border Style="{StaticResource GhCard}" BorderBrush="{DynamicResource AccentFlame}">
                            <StackPanel>
                                <TextBlock Text="Clone Hero / YARG Converter (1-Click)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" Margin="0,0,0,6"/>
                                <TextBlock Text="Select any Clone Hero song folder or .zip (containing song.ini + notes.chart/.mid + .ogg/.mp3 stems). Archives are scanned against zip bombs and disallowed executables before compiling straight into Guitar Hero III."
                                           FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Import Clone Hero Folder..." Style="{StaticResource FlameButton}" Margin="0,0,10,0" Click="ImportCloneHeroFolderBtn_Click"/>
                                    <Button Content="Import Clone Hero .zip..." Style="{StaticResource OutlineButton}" Click="ImportCloneHeroZipBtn_Click"/>
                                </StackPanel>
                                <ProgressBar x:Name="ChImportProgress" Visibility="Collapsed" Height="9" Margin="0,12,0,0"/>
                                <TextBlock x:Name="ChImportStatusText" Text="" FontSize="12.5" Foreground="{DynamicResource CardSuccessTitle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Standard GH3 Archive Import Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="GH3-Sync Archives (.gh3pack, .gh3song, .sgh)" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock Text="Imports pre-compiled custom songs and cleanly merges them into your existing DATA\customs.pak.xen without overwriting your current customs or breaking existing custom saves. Creator attribution is preserved automatically."
                                           FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Select Archive &amp; Import..." Style="{StaticResource GreenButton}" Click="ImportArchiveBtn_Click"/>
                                    <Button Content="Export Full Library (.gh3pack)" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="ExportAllPack_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ImportStatusText" Text="" FontSize="12.5" Foreground="{DynamicResource CardSuccessTitle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 7: CAREER SAVES ==================== -->
                    <StackPanel x:Name="PageSaves" Visibility="Collapsed">
                        <TextBlock Text="Career Saves &amp; Profile Snapshots" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>

                        <!-- Clear Honest GH3 Save Warning Banner -->
                        <Border Background="{DynamicResource CardDangerBg}" BorderBrush="{DynamicResource CardDangerBorder}" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="IMPORTANT: Guitar Hero III Save Compatibility Warning" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CardDangerTitle}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource CardDangerFg}" Margin="0,5,0,0" LineHeight="19">
                                    The first time custom songs are added to a vanilla Guitar Hero III save, the game prompts for a one-time save reset. After your custom profile (Honeycomb}{Honeycomb) is active, GH3-Sync merges additional songs cleanly into your existing DATA\customs.pak.xen.&#x0a;
                                    • Restoring a Profile Snapshot below restores BOTH your career save (s000.d / toc.dat) AND its matching customs.pak.xen cleanly, rolling your custom song list back to that snapshot without corrupt-save errors.&#x0a;
                                    • Tip: Save a named "Main Career" snapshot before adding your first custom song so you can always revert cleanly.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Create Named Snapshot Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Save Named Career + Setlist Profile" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                                    <TextBox x:Name="SaveProfileNameBox" Text="Main Career"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button Content="Save Profile Snapshot" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Click="BackupSaveNowBtn_Click"/>
                                    <Button Content="Restore Latest" Style="{StaticResource GreenButton}" Click="RestoreLatestSaveBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="SaveBackupsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 8: SETTINGS, THEMES, UPDATES & ABOUT ==================== -->
                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                        <TextBlock Text="Settings &amp; About" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure paths, P2P privacy, Guitar Hero Light/Dark themes, component updates, compatibility self-tests, and app info."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"/>

                        <!-- Settings Sub-Tab Strip -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="TabSetGeneralBtn" Content="General &amp; Paths" Style="{StaticResource FlameButton}" Padding="14,8" Margin="0,0,8,0" Click="SettingsSubTab_Click" Tag="general"/>
                            <Button x:Name="TabSetAppearanceBtn" Content="Appearance (Light / Dark)" Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,0" Click="SettingsSubTab_Click" Tag="appearance"/>
                            <Button x:Name="TabSetUpdatesBtn" Content="Updates &amp; Compatibility" Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,0" Click="SettingsSubTab_Click" Tag="updates"/>
                            <Button x:Name="TabSetAboutBtn" Content="About, Credits &amp; Logs" Style="{StaticResource OutlineButton}" Padding="14,8" Click="SettingsSubTab_Click" Tag="about"/>
                        </StackPanel>

                        <!-- SUB-TAB 1: GENERAL & PATHS -->
                        <StackPanel x:Name="SettingsSubGeneral">
                            <Border Style="{StaticResource GhCard}">
                                <StackPanel>
                                    <TextBlock Text="Game &amp; Library Paths" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

                                    <TextBlock Text="Guitar Hero III Installation Directory" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="SettingsBrowseGamePath_Click"/>
                                        <TextBox x:Name="SettingsGamePathBox"/>
                                    </DockPanel>

                                    <TextBlock Text="Custom Songs Project Directory" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <DockPanel Margin="0,0,0,12">
                                        <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="SettingsBrowseSongsPath_Click"/>
                                        <TextBox x:Name="SettingsSongsPathBox"/>
                                    </DockPanel>

                                    <TextBlock Text="Custom Compiler Path (Leave blank to use bundled Honeycomb engine)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="SettingsHoneycombPathBox" Margin="0,0,0,14"/>

                                    <TextBlock Text="Behavior &amp; P2P Privacy" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,10"/>
                                    <CheckBox x:Name="SettingsDirectInstallChk" Content="Install imported and synced songs directly into Guitar Hero III" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="SettingsMinLaunchChk" Content="Minimize GH3-Sync to system tray when launching GH3.exe" Margin="0,0,0,8"/>
                                    <CheckBox x:Name="SettingsP2pOnlineChk" Content="Online P2P Sharing Enabled (uncheck for Offline Mode — blocks external peers &amp; closes UPnP port 7373)" Margin="0,0,0,14"/>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                        <TextBlock Text="Lobby Auto-Sync Song Cap (1-25):" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBox x:Name="SettingsLobbyCapBox" Width="64" Text="10"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Save Settings" Style="{StaticResource FlameButton}" Padding="18,9" Click="SettingsSaveGeneral_Click"/>
                                        <TextBlock x:Name="SettingsSaveStatus" Text="" FontSize="12" Foreground="{DynamicResource CardSuccessTitle}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Storage & Duplicate Cleanup Card -->
                            <Border Style="{StaticResource GhCard}" BorderBrush="{DynamicResource AccentFlame}">
                                <StackPanel>
                                    <TextBlock Text="Storage Maintenance &amp; Duplicate Cleanup" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" Margin="0,0,0,6"/>
                                    <TextBlock Text="Removes leftover intermediate conversion MP3s, duplicate compiled .fsb.xen/.pak.xen copies inside Custom_Songs folders, duplicate song folders, and excess backup files — without touching your playable game songs."
                                               FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CleanTempFilesBtn" Content="Clean Duplicate &amp; Temp Files" Style="{StaticResource FlameButton}" Click="CleanTempFilesBtn_Click"/>
                                        <TextBlock x:Name="CleanTempResultText" Text="" FontSize="12" Foreground="{DynamicResource CardSuccessTitle}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SUB-TAB 2: APPEARANCE (CUSTOM LIGHT & DARK GH3 THEMES) -->
                        <StackPanel x:Name="SettingsSubAppearance" Visibility="Collapsed">
                            <Border Style="{StaticResource GhCard}">
                                <StackPanel>
                                    <TextBlock Text="Guitar Hero Theme Studio" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Switch between custom Guitar Hero Dark and Light themes instantaneously. Your choice is saved automatically."
                                               FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,16"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Dark GH3 Theme Card -->
                                        <Border x:Name="ThemeDarkCard" Grid.Column="0" Background="#0E1017" BorderBrush="#F97316" BorderThickness="2" CornerRadius="12" Padding="16">
                                            <StackPanel>
                                                <Border Height="5" CornerRadius="3" Margin="0,0,0,12">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#22C55E" Offset="0.0"/>
                                                            <GradientStop Color="#EF4444" Offset="0.25"/>
                                                            <GradientStop Color="#EAB308" Offset="0.5"/>
                                                            <GradientStop Color="#3B82F6" Offset="0.75"/>
                                                            <GradientStop Color="#F97316" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="Dark GH3 — Legends of Rock Stage" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC"/>
                                                <TextBlock Text="Stage obsidian dark surfaces, Legends of Rock crimson &amp; molten flame accents, glowing 5-fret highway gems."
                                                           FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Ellipse Width="14" Height="14" Fill="#090A0F" Stroke="#475569" StrokeThickness="1" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#141722" Stroke="#475569" StrokeThickness="1" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#E11D48" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#F97316" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#F59E0B"/>
                                                </StackPanel>
                                                <Button x:Name="SelectDarkThemeBtn" Content="Active Theme (Dark GH3)" Style="{StaticResource FlameButton}" Click="SelectDarkThemeBtn_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Light GH3 Theme Card -->
                                        <Border x:Name="ThemeLightCard" Grid.Column="2" Background="#F3F5F9" BorderBrush="#CBD5E1" BorderThickness="2" CornerRadius="12" Padding="16">
                                            <StackPanel>
                                                <Border Height="5" CornerRadius="3" Margin="0,0,0,12">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#16A34A" Offset="0.0"/>
                                                            <GradientStop Color="#DC2626" Offset="0.25"/>
                                                            <GradientStop Color="#CA8A04" Offset="0.5"/>
                                                            <GradientStop Color="#2563EB" Offset="0.75"/>
                                                            <GradientStop Color="#EA580C" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="Light GH3 — Backstage Amp &amp; Steel" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                                <TextBlock Text="Crisp backstage ivory &amp; brushed amp steel panels, high-contrast slate typography, crimson &amp; amber gold highlights."
                                                           FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                                    <Ellipse Width="14" Height="14" Fill="#FFFFFF" Stroke="#94A3B8" StrokeThickness="1" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#E7EBF3" Stroke="#94A3B8" StrokeThickness="1" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#DC2626" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#EA580C" Margin="0,0,6,0"/>
                                                    <Ellipse Width="14" Height="14" Fill="#D97706"/>
                                                </StackPanel>
                                                <Button x:Name="SelectLightThemeBtn" Content="Switch to Light GH3 Theme" Style="{StaticResource OutlineButton}" Click="SelectLightThemeBtn_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- SUB-TAB 3: UPDATES & COMPATIBILITY SELF-TEST -->
                        <StackPanel x:Name="SettingsSubUpdates" Visibility="Collapsed">
                            <Border Style="{StaticResource GhCard}">
                                <StackPanel>
                                    <TextBlock Text="Component Updates &amp; Post-Update Compatibility" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Verify GH3-Sync, Honeycomb compiler, BetterGH3, FFmpeg, and Demucs/Basic Pitch versions. Run a 5-point compatibility self-test anytime to make sure every feature works properly."
                                               FontSize="12.5" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <CheckBox x:Name="SettingsAutoRollbackChk" Content="Automatically roll back stem package updates if post-update compatibility check fails" Margin="0,0,0,12" Checked="SettingsAutoRollbackChk_Changed" Unchecked="SettingsAutoRollbackChk_Changed"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Button x:Name="CheckAllComponentsBtn" Content="Check All Component Updates" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Click="CheckAllComponentsBtn_Click"/>
                                        <Button x:Name="RunCompatTestBtn" Content="Run Compatibility Self-Test" Style="{StaticResource GreenButton}" Margin="0,0,8,0" Click="RunCompatTestBtn_Click"/>
                                        <Button x:Name="UpdateStemToolsBtn" Content="Update Stem Packages (Safe)" Style="{StaticResource OutlineButton}" Click="UpdateStemToolsBtn_Click"/>
                                    </StackPanel>

                                    <TextBlock x:Name="UpdatesCompStatusText" Text="Click 'Check All Component Updates' or 'Run Compatibility Self-Test' to verify your installation."
                                               FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="ComponentsStatusPanel"/>
                            <StackPanel x:Name="CompatTestPanel"/>
                        </StackPanel>

                        <!-- SUB-TAB 4: ABOUT, CREDITS & LOGS -->
                        <StackPanel x:Name="SettingsSubAbout" Visibility="Collapsed">
                            <!-- Developer & Updates Card -->
                            <Border Style="{StaticResource GhCard}" BorderBrush="{DynamicResource AccentGold}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="GH3-Sync v1.3.1 — Created by Mad Scientist" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                            <TextBlock Text="GitHub: " FontSize="12.5" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock FontSize="12.5">
                                                <Hyperlink NavigateUri="https://github.com/tbailey639" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource AccentFlameText}">github.com/tbailey639 (tbailey639)</Hyperlink>
                                            </TextBlock>
                                            <TextBlock Text="  •  " FontSize="12.5" Foreground="{DynamicResource TextSectionHeader}"/>
                                            <TextBlock FontSize="12.5">
                                                <Hyperlink NavigateUri="https://github.com/tbailey639/GH3-Sync" RequestNavigate="Hyperlink_RequestNavigate" Foreground="{DynamicResource CardInfoTitle}">GH3-Sync Repository</Hyperlink>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock x:Name="AboutUpdateStatus" Text="Version 1.3.1" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Check for Updates" Style="{StaticResource FlameButton}" VerticalAlignment="Center" Click="CheckUpdatesBtn_Click"/>
                                </Grid>
                            </Border>

                            <!-- Credits Card -->
                            <Border Style="{StaticResource GhCard}" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}">
                                <StackPanel>
                                    <TextBlock Text="Credits &amp; Open-Source Acknowledgments" FontSize="15.5" FontWeight="Bold" Foreground="{DynamicResource CardSuccessTitle}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource CardSuccessFg}" FontSize="12.5" LineHeight="21">
                                        • Honeycomb-GUI &amp; GH-Toolkit-Core — AddyMills &amp; the Neversoft modding community (PAK/QB compilation &amp; checksum tables)&#x0a;
                                        • Demucs (htdemucs_6s) — Alexandre Défossez et al., Meta AI Research (6-stem audio separation)&#x0a;
                                        • Basic Pitch — Spotify Audio Intelligence Lab (polyphonic pitch-to-MIDI transcription)&#x0a;
                                        • BetterGH3 — Marchello &amp; the BetterGH3 Team (Guitar Hero III PC mod &amp; online multiplayer)&#x0a;
                                        • Neversoft Entertainment &amp; Activision — Guitar Hero III: Legends of Rock&#x0a;
                                        • FFmpeg, FMOD/FSB Tools, NAudio (Mark Heath), DryWetMidi (Maxim Dobroselsky), Python-Build-Standalone (Astral)&#x0a;
                                        • Licensed under PolyForm Noncommercial License 1.0.0
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Known Limitations Card (Clean & Accurate!) -->
                            <Border Style="{StaticResource GhCard}">
                                <StackPanel>
                                    <TextBlock Text="Known Limitations" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" Margin="0,0,0,6"/>
                                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" LineHeight="20">
                                        • Adding your first custom song to a vanilla Guitar Hero III profile updates DATA\customs.pak.xen, which triggers a one-time in-game save reset. Back up your vanilla profile in Career Saves first if you want to keep it.&#x0a;
                                        • Restoring a Career Save snapshot rolls back both your save file and your custom song list together so they remain matched.
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Diagnostic Logs -->
                            <Border Style="{StaticResource GhCard}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Content="Refresh Logs" Style="{StaticResource OutlineButton}" Padding="10,4" Click="RefreshLogsBtn_Click"/>
                                        <TextBlock Text="Diagnostic Logs" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <TextBox x:Name="LogsViewerBox" Height="200" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                             TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             Background="{DynamicResource LogBoxBg}" Foreground="{DynamicResource LogBoxFg}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ==================== BUILT-IN AUDIO & STEM PREVIEW BAR ==================== -->
        <Border x:Name="AudioPlayerBar" Grid.Row="4" Visibility="Collapsed"
                Background="{DynamicResource PlayerBarBg}" BorderBrush="{DynamicResource AccentFlame}" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PlayerPlayPauseBtn" Content="⏸" Style="{StaticResource FlameButton}" Padding="10,5" Margin="0,0,6,0" Click="PlayerPlayPauseBtn_Click"/>
                    <Button Content="⏹" Style="{StaticResource OutlineButton}" Padding="9,5" Margin="0,0,12,0" Click="PlayerStopBtn_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="PlayerTrackTitle" Text="Previewing..." FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PlayerTimeText" Text="0:00 / 0:00" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="Consolas"/>
                </StackPanel>

                <Slider x:Name="PlayerSeekSlider" Grid.Column="2" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                        PreviewMouseLeftButtonUp="PlayerSeekSlider_MouseUp"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="PlayerStemToggleBtn" Content="Solo Guitar Stem" Style="{StaticResource OutlineButton}" Padding="9,4" Margin="0,0,6,0" Visibility="Collapsed" Click="PlayerStemToggleBtn_Click"/>
                    <Button x:Name="PlayerSetPreviewBtn" Content="Set Preview Start Here" Style="{StaticResource GreenButton}" Padding="10,4" Margin="0,0,6,0" Click="PlayerSetPreviewBtn_Click"/>
                    <Button Content="✕" Style="{StaticResource OutlineButton}" Padding="8,4" Click="PlayerCloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
