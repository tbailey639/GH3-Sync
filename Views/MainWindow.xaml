<Window x:Class="GH3_Sync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync v1.5.0"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1360" Height="880"
        MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgStage}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml"/>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 5-Fret Accent Strip -->
        <Border Grid.Row="0" Background="{DynamicResource FretBarGradient}"/>

        <!-- ==================== TOP HEADER BAR ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/gh3_sync_logo.png"
                           Width="40" Height="40" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GH3" FontSize="21" FontWeight="Black" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="-SYNC" FontSize="21" FontWeight="Black" Foreground="{DynamicResource FlameGradient}"/>
                            <Border Background="{DynamicResource VersionBadgeBg}" BorderBrush="{DynamicResource VersionBadgeBorder}" BorderThickness="1" CornerRadius="5" Padding="7,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v1.5.0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Guitar Hero III Companion  •  by Mad Scientist" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="GameStatusPill" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}" BorderThickness="1"
                            CornerRadius="16" Padding="11,5" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
                            <TextBlock x:Name="GameStatusText" Text="BetterGH3 Ready" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CardSuccessTitle}"/>
                        </StackPanel>
                    </Border>

                    <Button Content="▶ Launch GH3" Style="{StaticResource GreenButton}" Padding="13,7" Margin="0,0,8,0" Click="LaunchGh3Btn_Click"/>
                    <Button x:Name="HeaderUpdateBtn" Content="Check Updates" Style="{StaticResource OutlineButton}" Click="CheckUpdatesBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== UPDATE BANNER ==================== -->
        <Border x:Name="UpdateBanner" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource CardWarnBg}" BorderBrush="{DynamicResource CardWarnBorder}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerTitle" Text="Update available" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource CardWarnTitle}"/>
                    <TextBlock x:Name="UpdateBannerSubtitle" Text="Click Update Now to download and install." FontSize="12" Foreground="{DynamicResource CardWarnFg}" Margin="0,2,0,0"/>
                    <ProgressBar x:Name="UpdateBannerProgress" Visibility="Collapsed" Height="8" Margin="0,8,16,0" Minimum="0" Maximum="100"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNowBtn" Content="Update Now" Style="{StaticResource FlameButton}" Margin="0,0,8,0" Click="UpdateNowBtn_Click"/>
                    <Button Content="✕" Style="{StaticResource OutlineButton}" Padding="10,6" Click="DismissUpdateBanner_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN BODY ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource BgSidebar}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="10" Margin="10" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="SidebarProfileName" Text="Player" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="SidebarFriendCode" Text="GH3-XXXX-XXXX" FontSize="11.5" Foreground="{DynamicResource AccentFlameText}" FontFamily="Consolas" Margin="0,2,0,4"/>
                            <TextBlock x:Name="SidebarLobbySummary" Text="Lobby Auto-Sync: 0 / 10" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="SidebarP2pModeText" Text="P2P Sharing: Online" FontSize="10.5" Foreground="{DynamicResource CardSuccessTitle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="LIBRARY" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSectionHeader}" Margin="18,6,0,6"/>
                            <RadioButton x:Name="NavCustoms" Content="My Customs" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavCreator" Content="ONOGAMI Song Creator" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAiTools" Content="Tools &amp; Stems" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>

                            <TextBlock Text="MULTIPLAYER" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSectionHeader}" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavFriends" Content="Friends &amp; Trust" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavP2P" Content="P2P Sync &amp; Lobby" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavImport" Content="Import &amp; Convert" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>

                            <TextBlock Text="SYSTEM" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSectionHeader}" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavSaves" Content="Career Saves" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- CONTENT PAGES -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <Grid>

                    <!-- ==================== PAGE 1: MY CUSTOMS ==================== -->
                    <StackPanel x:Name="PageCustoms">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CustomsHeaderTitle" Text="Installed Custom Songs" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="CustomsGamePathLabel" Text="Scanning library..." FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Refresh" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="RefreshSongs_Click"/>
                                <Button x:Name="ExportLobbyPackBtn" Content="Export Lobby Pack" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="ExportLobbyPack_Click"/>
                                <Button x:Name="ExportSelectedBtn" Content="Export Selected (0)" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="ExportSelectedPack_Click"/>
                                <Button Content="Export All (.gh3pack)" Style="{StaticResource FlameButton}" Click="ExportAllPack_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter, Sort & Search Bar -->
                        <Border Style="{StaticResource GhCard}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FilterAllBtn" Content="All" Style="{StaticResource FlameButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="all"/>
                                    <Button x:Name="FilterCreatedBtn" Content="Made with Creator" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="created"/>
                                    <Button x:Name="FilterSyncedBtn" Content="Synced / Imported" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="synced"/>
                                    <Button x:Name="FilterFavBtn" Content="★ Favorites" Style="{StaticResource OutlineButton}" Padding="11,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="favorites"/>
                                    <Button x:Name="FilterLobbyBtn" Content="Lobby Setlist (0/10)" Style="{StaticResource OutlineButton}" Padding="11,6" Click="FilterSongs_Click" Tag="lobby"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="SongSortCombo" Width="128" Margin="0,0,8,0" SelectionChanged="SongSortCombo_SelectionChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Sort: Title A-Z"/>
                                        <ComboBoxItem Content="Sort: Artist A-Z"/>
                                        <ComboBoxItem Content="Sort: Newest"/>
                                        <ComboBoxItem Content="Sort: Largest"/>
                                    </ComboBox>
                                    <TextBox x:Name="SongSearchBox" Width="195" TextChanged="SongSearchBox_TextChanged" ToolTip="Search title, artist, or song ID"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Active Temporary Session Notice on Customs Page -->
                        <Border x:Name="CustomsTempSessionBanner" Visibility="Collapsed"
                                Background="{DynamicResource CardInfoBg}" BorderBrush="{DynamicResource CardInfoBorder}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CustomsTempSessionText" Text="Temporary Lobby Session active." FontSize="12.5" Foreground="{DynamicResource CardInfoFg}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="End Session &amp; Clean Up" Style="{StaticResource DangerButton}" Padding="12,6" Click="EndTempSessionBtn_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="Tip: Drag and drop any .gh3song, .gh3pack, Clone Hero .sng/.zip/folder, or audio file directly onto this window."
                                   FontSize="11.5" Foreground="{DynamicResource TextSectionHeader}" Margin="2,-4,0,10"/>

                        <StackPanel x:Name="SongsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 2: SONG CREATOR ==================== -->
                    <StackPanel x:Name="PageCreator" Visibility="Collapsed">
                        <TextBlock Text="ONOGAMI Song Creator" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="Create custom songs with dynamic beat tracking, pitch-mapped charting, stem separation, and batch compilation."
                                   FontSize="12.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,14"/>

                        <!-- Compiler & Auto-Install Bar -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource CardSuccessBg}" BorderBrush="{DynamicResource CardSuccessBorder}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Song Compiler" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CardSuccessTitle}"/>
                                        <Border Background="#064E3B" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorCompilerBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#6EE7B7"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorCompilerMsg" Text="Compiles .pak.xen chart and .fsb.xen audio soundbanks directly into Guitar Hero III."
                                               FontSize="12" Foreground="{DynamicResource CardSuccessFg}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CrAutoCompileChk" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                          Content="Auto-Compile &amp; Install into Game" Foreground="{DynamicResource CardSuccessTitle}" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- Stem Separator Bar -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource CardInfoBg}" BorderBrush="{DynamicResource CardInfoBorder}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Multi-Track Stem Separation (Demucs 6-Stem + Basic Pitch)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource CardInfoTitle}"/>
                                        <Border x:Name="CreatorAiBadgeBorder" Background="#1E3A8A" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorAiBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#BFDBFE"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorAiMsg" Text="Isolates Guitar, Bass, Drums, Vocals &amp; Piano for mute-on-miss gameplay and cleaner note transcription."
                                               FontSize="12" Foreground="{DynamicResource CardInfoFg}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CrSeparateStemsChk" Content="Separate Stems" Foreground="{DynamicResource CardInfoTitle}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <Button x:Name="CreatorQuickInstallAiBtn" Content="Install Stem Tools" Style="{StaticResource BlueButton}" Padding="12,6" Click="GoToAiManager_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Community Handcrafted Chart Search (Chorus Encore) -->
                        <Border Style="{StaticResource GhCard}" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource AccentFlame}" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="1-Click Handcrafted Community Charts (Chorus Encore)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Search community charts • Or auto-generate below" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DockPanel>
                                    <Button x:Name="CommunitySearchBtn" DockPanel.Dock="Right" Content="Search Charts" Style="{StaticResource FlameButton}" Padding="14,6" Margin="8,0,0,0" Click="CommunitySearchBtn_Click"/>
                                    <TextBox x:Name="CommunitySearchBox" KeyDown="CommunitySearchBox_KeyDown" ToolTip="Search song title or artist"/>
                                </DockPanel>
                                <!-- Smart Filters Row -->
                                <DockPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="CommunityFullDiffsOnlyChk" Content="Full Difficulties Only (Easy–Expert)" Margin="0,0,14,0" VerticalAlignment="Center" Checked="CommunityFilter_Changed" Unchecked="CommunityFilter_Changed"/>
                                        <CheckBox x:Name="CommunityClassicFretsChk" Content="Classic 5-Fret GH3 (Convert Open Notes)" VerticalAlignment="Center" Checked="CommunityClassicFretsChk_Changed" Unchecked="CommunityClassicFretsChk_Changed" ToolTip="Converts Clone Hero purple open-strum bars into classic green notes"/>
                                    </StackPanel>
                                    <ComboBox x:Name="CommunitySortCombo" DockPanel.Dock="Right" Width="155" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CommunitySortCombo_SelectionChanged">
                                        <ComboBoxItem Content="Sort: Best Match"/>
                                        <ComboBoxItem Content="Sort: Most Notes"/>
                                        <ComboBoxItem Content="Sort: Difficulty"/>
                                    </ComboBox>
                                </DockPanel>
                                <TextBlock x:Name="CommunitySearchStatus" Text="" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                <ProgressBar x:Name="CommunityInstallProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="CommunityResultsScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed">
                                    <StackPanel x:Name="CommunityResultsPanel"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Main Form Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Chart Mode" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <RadioButton x:Name="ModeAutoGenRadio" Content="Auto-Generate Chart from Audio" Foreground="{DynamicResource TextPrimary}" FontSize="13" IsChecked="True" Margin="0,0,24,0" Checked="ChartMode_Changed"/>
                                    <RadioButton x:Name="ModeUploadRadio" Content="Use Existing Chart / MIDI (.chart or .mid)" Foreground="{DynamicResource TextPrimary}" FontSize="13" Checked="ChartMode_Changed"/>
                                </StackPanel>

                                <!-- File Pickers -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Audio File (.mp3, .wav, .ogg) *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="▶ Preview" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="PreviewCreatorAudioBtn_Click"/>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="BrowseAudioBtn_Click"/>
                                            <TextBox x:Name="CrAudioPathBox" IsReadOnly="True"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="ChartPickerPanel" Grid.Column="2" Visibility="Collapsed">
                                        <TextBlock Text="Chart / MIDI File (.chart or .mid) *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Browse..." Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="BrowseChartBtn_Click"/>
                                            <TextBox x:Name="CrChartPathBox" IsReadOnly="True"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="BpmPickerPanel" Grid.Column="2">
                                        <DockPanel Margin="0,0,0,4">
                                            <Button DockPanel.Dock="Right" Content="Detect BPM" Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="11" Click="DetectBpmBtn_Click"/>
                                            <TextBlock Text="Tempo (BPM)" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="BpmStatusLabel" DockPanel.Dock="Right" Text="" FontSize="11.5" Foreground="{DynamicResource CardSuccessTitle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            <TextBox x:Name="CrBpmBox" Text="130"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Auto-Chart & Audio Mix Tuning Row -->
                                <Grid x:Name="ChartTuningRow" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.25*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1.35*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Chart Density / Feel" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrFeelCombo" SelectedIndex="1">
                                            <ComboBoxItem Content="Casual"/>
                                            <ComboBoxItem Content="Standard"/>
                                            <ComboBoxItem Content="Shredder"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Playable Instrument Focus (Basic Pitch AI)" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrFocusCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Auto (Smart Multi-Lead — Play the Hook)"/>
                                            <ComboBoxItem Content="Lead Guitar (Rock / Metal)"/>
                                            <ComboBoxItem Content="Keys / Synth / Sax (Non-Guitar Melodic)"/>
                                            <ComboBoxItem Content="Groove Bassline"/>
                                            <ComboBoxItem Content="Vocal Melody"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Game Audio Mix Mode" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="CrAudioMixCombo" SelectedIndex="0">
                                            <ComboBoxItem Content="Auto (Recommended — Best for Song Type)"/>
                                            <ComboBoxItem Content="Studio Master (Cleanest Original Audio)"/>
                                            <ComboBoxItem Content="Isolated Lead Stem (Mute-on-Miss)"/>
                                            <ComboBoxItem Content="Hybrid Blend (Studio Clarity + Soft Ducking)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <DockPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5">
                                        <CheckBox x:Name="CrVariableTempoChk" IsChecked="True" Content="Smart Tempo Detection (Studio Constant Grid vs. Live Variable Map)" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="CrPreviewStartLabel" Text="Menu Preview Start: 5.0s" FontSize="11.5" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </Grid>

                                <!-- Metadata Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Song Title *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrTitleBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Artist Name *" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrArtistBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Album" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrAlbumBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Year" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrYearBox" Text="2026"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Genre" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrGenreBox" Text="Rock"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="Charter Name" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrCharterBox" Text="Mad Scientist"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Actions + Interactive Editable Batch Queue -->
                                <StackPanel Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CreateSongSubmitBtn" Content="Create &amp; Compile Song" Style="{StaticResource FlameButton}" Padding="20,10" FontSize="13.5" Click="CreateSongBtn_Click"/>
