                            <Button x:Name="TabSetAppearanceBtn" Content="Appearance &amp; Overlay" Style="{StaticResource OutlineButton}" Padding="13,7" Margin="0,0,7,6" Click="SettingsSubTab_Click" Tag="appearance"/>
                            <Button x:Name="TabSetUpdatesBtn" Content="Updates &amp; Compatibility" Style="{StaticResource OutlineButton}" Padding="13,7" Margin="0,0,7,6" Click="SettingsSubTab_Click" Tag="updates"/>
