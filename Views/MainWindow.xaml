                                <Rectangle Canvas.Left="122" Canvas.Top="54" Width="6" Height="42" RadiusX="2" RadiusY="2" Fill="#1E293B"/>
                                <Rectangle Canvas.Left="130" Canvas.Top="54" Width="6" Height="42" RadiusX="2" RadiusY="2" Fill="#1E293B"/>

                                <Rectangle Canvas.Left="160" Canvas.Top="50" Width="22" Height="50" RadiusX="3" RadiusY="3" Fill="#0B1120" Stroke="#64748B" StrokeThickness="1.2"/>
                                <Rectangle Canvas.Left="164" Canvas.Top="54" Width="6" Height="42" RadiusX="2" RadiusY="2" Fill="#1E293B"/>
                                <Rectangle Canvas.Left="172" Canvas.Top="54" Width="6" Height="42" RadiusX="2" RadiusY="2" Fill="#1E293B"/>

                                <!-- Volume & Tone Knobs -->
                                <Ellipse Canvas.Left="138" Canvas.Top="112" Width="12" Height="12" Fill="#334155" Stroke="#94A3B8" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="158" Canvas.Top="116" Width="12" Height="12" Fill="#334155" Stroke="#94A3B8" StrokeThickness="1.2"/>

                                <!-- Fretboard Neck (x=204..526, y=55..95) -->
                                <Rectangle Canvas.Left="204" Canvas.Top="55" Width="322" Height="40" Fill="{StaticResource FretboardGrad}" Stroke="#475569" StrokeThickness="1.4"/>

                                <!-- Silver Fret Bars -->
                                <Line X1="224" Y1="56" X2="224" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="246" Y1="56" X2="246" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="268" Y1="56" X2="268" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="291" Y1="56" X2="291" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="314" Y1="56" X2="314" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="338" Y1="56" X2="338" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="362" Y1="56" X2="362" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="386" Y1="56" X2="386" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="411" Y1="56" X2="411" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="436" Y1="56" X2="436" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="461" Y1="56" X2="461" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="486" Y1="56" X2="486" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>
                                <Line X1="510" Y1="56" X2="510" Y2="94" Stroke="#64748B" StrokeThickness="1.4"/>

                                <!-- Pearl Fret Inlay Markers -->
                                <Ellipse Canvas.Left="254" Canvas.Top="72" Width="6" Height="6" Fill="#94A3B8" Opacity="0.55"/>
                                <Ellipse Canvas.Left="300" Canvas.Top="72" Width="6" Height="6" Fill="#94A3B8" Opacity="0.55"/>
                                <Ellipse Canvas.Left="347" Canvas.Top="72" Width="6" Height="6" Fill="#94A3B8" Opacity="0.55"/>
                                <Ellipse Canvas.Left="396" Canvas.Top="72" Width="6" Height="6" Fill="#94A3B8" Opacity="0.55"/>
                                <Ellipse Canvas.Left="446" Canvas.Top="64" Width="5.5" Height="5.5" Fill="#94A3B8" Opacity="0.6"/>
                                <Ellipse Canvas.Left="446" Canvas.Top="80" Width="5.5" Height="5.5" Fill="#94A3B8" Opacity="0.6"/>
                                <Ellipse Canvas.Left="495" Canvas.Top="72" Width="6" Height="6" Fill="#94A3B8" Opacity="0.55"/>

                                <!-- Bone/Chrome Nut (Right String Progress End at x=526) -->
                                <Rectangle Canvas.Left="524" Canvas.Top="54" Width="5" Height="42" RadiusX="1.5" RadiusY="1.5" Fill="#CBD5E1"/>

                                <!-- Rock Headstock Silhouette -->
                                <Path Data="M 529,56 L 548,46 L 622,42 L 628,58 L 614,76 L 624,96 L 612,106 L 548,100 L 529,94 Z"
                                      Fill="{StaticResource GuitarBodyGrad}" Stroke="#334155" StrokeThickness="2"/>

                                <!-- 6 Chrome Tuning Pegs (3 Top, 3 Bottom) -->
                                <Ellipse Canvas.Left="552" Canvas.Top="36" Width="10" Height="10" Fill="#64748B" Stroke="#CBD5E1" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="574" Canvas.Top="34" Width="10" Height="10" Fill="#64748B" Stroke="#CBD5E1" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="596" Canvas.Top="32" Width="10" Height="10" Fill="#64748B" Stroke="#CBD5E1" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="552" Canvas.Top="102" Width="10" Height="10" Fill="#64748B" Stroke="#CBD5E1" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="574" Canvas.Top="104" Width="10" Height="10" Fill="#64748B" Stroke="#CBD5E1" StrokeThickness="1.2"/>
                                <Ellipse Canvas.Left="596" Canvas.Top="106" Width="10" Height="10" Fill="#64748B" Stroke="#CBD5E1" StrokeThickness="1.2"/>

                                <!-- Headstock String Extensions (Nut to Tuning Posts) -->
                                <Line X1="528" Y1="60" X2="557" Y2="52" Stroke="#475569" StrokeThickness="1.2"/>
                                <Line X1="528" Y1="66" X2="579" Y2="51" Stroke="#475569" StrokeThickness="1.3"/>
                                <Line X1="528" Y1="72" X2="601" Y2="50" Stroke="#475569" StrokeThickness="1.4"/>
                                <Line X1="528" Y1="78" X2="601" Y2="96" Stroke="#475569" StrokeThickness="1.6"/>
                                <Line X1="528" Y1="84" X2="579" Y2="95" Stroke="#475569" StrokeThickness="1.8"/>
                                <Line X1="528" Y1="90" X2="557" Y2="94" Stroke="#475569" StrokeThickness="2.0"/>

                                <!-- UNFILLED 6 GUITAR STRINGS (Background Metallic Tracks: x=92 to x=526) -->
                                <Line X1="92" Y1="60" X2="526" Y2="60" Stroke="#334155" StrokeThickness="1.5"/>
                                <Line X1="92" Y1="66" X2="526" Y2="66" Stroke="#334155" StrokeThickness="1.7"/>
                                <Line X1="92" Y1="72" X2="526" Y2="72" Stroke="#334155" StrokeThickness="1.9"/>
                                <Line X1="92" Y1="78" X2="526" Y2="78" Stroke="#334155" StrokeThickness="2.1"/>
                                <Line X1="92" Y1="84" X2="526" Y2="84" Stroke="#334155" StrokeThickness="2.3"/>
                                <Line X1="92" Y1="90" X2="526" Y2="90" Stroke="#334155" StrokeThickness="2.6"/>

                                <!-- FILLED 6 GUITAR STRINGS (Electric Blue Progress Fill, Clipped Dynamically 0% -> 100%) -->
                                <Canvas x:Name="GuitarStringsFillLayer" Width="640" Height="150">
                                    <Canvas.Clip>
                                        <RectangleGeometry x:Name="GuitarStringsClip" Rect="92,48,0,54"/>
                                    </Canvas.Clip>
                                    <Canvas.Effect>
                                        <DropShadowEffect Color="#00D2FF" BlurRadius="12" ShadowDepth="0" Opacity="0.95"/>
                                    </Canvas.Effect>
                                    <Line X1="92" Y1="60" X2="526" Y2="60" Stroke="{StaticResource BlueStringGrad}" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="92" Y1="66" X2="526" Y2="66" Stroke="{StaticResource BlueStringGrad}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="92" Y1="72" X2="526" Y2="72" Stroke="{StaticResource BlueStringGrad}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="92" Y1="78" X2="526" Y2="78" Stroke="{StaticResource BlueStringGrad}" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="92" Y1="84" X2="526" Y2="84" Stroke="{StaticResource BlueStringGrad}" StrokeThickness="2.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="92" Y1="90" X2="526" Y2="90" Stroke="{StaticResource BlueStringGrad}" StrokeThickness="3.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>

                                <!-- Glowing Leading-Edge Pulse Bar Tracking Across the Strings -->
                                <Rectangle x:Name="GuitarProgressPulse" Canvas.Left="90" Canvas.Top="55" Width="5" Height="40"
                                           RadiusX="2.5" RadiusY="2.5" Fill="#E0F2FE" Visibility="Collapsed">
                                    <Rectangle.Effect>
                                        <DropShadowEffect Color="#38BDF8" BlurRadius="14" ShadowDepth="0" Opacity="1"/>
                                    </Rectangle.Effect>
                                </Rectangle>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <!-- Action Row: Show Details Toggle + Close (on error/cancel) -->
                    <DockPanel>
                        <Button x:Name="UpdateDetailsToggleBtn" DockPanel.Dock="Left" Content="Show Details ▼"
                                Style="{StaticResource OutlineButton}" Padding="12,6" FontSize="12"
                                Click="UpdateDetailsToggleBtn_Click"/>
                        <Button x:Name="UpdateOverlayCloseBtn" DockPanel.Dock="Right" Content="Close"
                                Style="{StaticResource OutlineButton}" Padding="14,6" FontSize="12"
                                Visibility="Collapsed" Click="UpdateOverlayCloseBtn_Click"/>
                        <TextBlock x:Name="UpdateGuitarSubnote" Text="Using existing config • Silent background upgrade"
                                   FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    </DockPanel>

                    <!-- Collapsible Verbose Output Drawer -->
                    <Border x:Name="UpdateVerboseLogPanel" Visibility="Collapsed" Margin="0,12,0,0"
                            Background="#050811" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="10">
                        <TextBox x:Name="UpdateVerboseLogBox" Height="150" IsReadOnly="True"
                                 FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"
                                 Foreground="#93C5FD"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
