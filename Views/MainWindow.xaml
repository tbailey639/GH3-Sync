<Window x:Class="GH3_Sync.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync Beta 5 — BetterGH3 Companion &amp; ONOGAMI Song Creator"
        Icon="pack://application:,,,/Assets/app_icon.ico"
        Width="1340" Height="860"
        MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#090A0F"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <ResourceDictionary Source="AppTheme.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="66"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top 5-Fret Highway Color Accent Bar -->
        <Border Grid.Row="0" Background="{StaticResource FretBarGradient}"/>

        <!-- ==================== TOP CONCERT HEADER BAR ==================== -->
        <Border Grid.Row="1" Background="#0E1017" BorderBrush="#262B3D" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo + Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/gh3_sync_logo.png"
                           Width="42" Height="42" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="GH3" FontSize="22" FontWeight="Black" Foreground="White"/>
                            <TextBlock Text="-SYNC" FontSize="22" FontWeight="Black" Foreground="{StaticResource FlameGradient}"/>
                            <Border Background="#2A161F" BorderBrush="#E11D48" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BETA 5 • NATIVE WIN11" FontSize="10" FontWeight="Bold" Foreground="#FB7185"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Legends of Rock Companion  •  P2P Sync  •  ONOGAMI AI Song Creator"
                                   FontSize="11.5" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right Header Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- BetterGH3 Live Status Pill -->
                    <Border x:Name="GameStatusPill" Background="#12211A" BorderBrush="#10B981" BorderThickness="1"
                            CornerRadius="16" Padding="12,5" Margin="0,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="GameStatusDot" Width="8" Height="8" Fill="#22C55E" Margin="0,0,7,0"/>
                            <TextBlock x:Name="GameStatusText" Text="BetterGH3 Connected" FontSize="12" FontWeight="SemiBold" Foreground="#6EE7B7"/>
                        </StackPanel>
                    </Border>

                    <!-- Check for Updates Button -->
                    <Button x:Name="HeaderUpdateBtn" Content="🔄 Check Updates" Style="{StaticResource OutlineButton}"
                            Margin="0,0,8,0" Click="CheckUpdatesBtn_Click"/>

                    <!-- Game Config Button -->
                    <Button Content="⚙️ Game Config" Style="{StaticResource OutlineButton}"
                            Click="GameConfigBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== AUTO-UPDATE NOTIFICATION BANNER ==================== -->
        <Border x:Name="UpdateBanner" Grid.Row="2" Visibility="Collapsed"
                Background="#241A0B" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdateBannerTitle" Text="🚀 A new version of GH3-Sync is available!"
                               FontSize="13.5" FontWeight="Bold" Foreground="#FCD34D"/>
                    <TextBlock x:Name="UpdateBannerSubtitle" Text="Click Update Now to download and install automatically."
                               FontSize="12" Foreground="#FDE68A" Margin="0,2,0,0"/>
                    <ProgressBar x:Name="UpdateBannerProgress" Visibility="Collapsed" Height="8" Margin="0,8,16,0" Minimum="0" Maximum="100"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateNowBtn" Content="⬇ Update Now" Style="{StaticResource FlameButton}"
                            Margin="0,0,8,0" Click="UpdateNowBtn_Click"/>
                    <Button Content="✕" Style="{StaticResource OutlineButton}" Padding="10,6" Click="DismissUpdateBanner_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN BODY (SIDEBAR + CONTENT) ==================== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#0E1017" BorderBrush="#262B3D" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Bottom Profile Mini-Card -->
                    <Border DockPanel.Dock="Bottom" Background="#141722" BorderBrush="#262B3D" BorderThickness="1"
                            CornerRadius="10" Margin="10" Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="SidebarProfileName" Text="Player" FontSize="13" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="SidebarFriendCode" Text="GH3-XXXX-XXXX" FontSize="11.5" Foreground="#FB923C" FontFamily="Consolas" Margin="0,2,0,4"/>
                            <TextBlock x:Name="SidebarPortInfo" Text="P2P Port 7373 Active" FontSize="10.5" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation Links -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="LIBRARY &amp; CREATION" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="18,6,0,6"/>
                            <RadioButton x:Name="NavCustoms" Content="🎸  My Customs" Style="{StaticResource NavButtonStyle}" IsChecked="True" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavCreator" Content="🔥  ONOGAMI Creator" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAiTools" Content="🤖  AI &amp; Tools Manager" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>

                            <TextBlock Text="MULTIPLAYER &amp; SYNC" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavFriends" Content="👥  Friends &amp; Trust" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavP2P" Content="🌐  P2P Sync &amp; NAT" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavImport" Content="📦  Import / Export" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>

                            <TextBlock Text="SYSTEM &amp; SAFETY" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavSaves" Content="💾  Career Saves" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                            <RadioButton x:Name="NavAbout" Content="📜  Logs, Updates &amp; Credits" Style="{StaticResource NavButtonStyle}" Checked="Nav_Checked"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
                <Grid>

                    <!-- ==================== PAGE 1: MY CUSTOMS ==================== -->
                    <StackPanel x:Name="PageCustoms">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CustomsHeaderTitle" Text="🎸 Installed Custom Songs" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="CustomsGamePathLabel" Text="Scanning Guitar Hero III library..." FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔄 Refresh" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="RefreshSongs_Click"/>
                                <Button Content="📦 Export All as Pack" Style="{StaticResource FlameButton}" Click="ExportAllPack_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Filter & Search Bar -->
                        <Border Style="{StaticResource GhCard}" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="FilterAllBtn" Content="All Songs" Style="{StaticResource FlameButton}" Padding="12,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="all"/>
                                    <Button x:Name="FilterCreatedBtn" Content="Created by Me (ONOGAMI)" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0" Click="FilterSongs_Click" Tag="created"/>
                                    <Button x:Name="FilterSyncedBtn" Content="Synced / Imported" Style="{StaticResource OutlineButton}" Padding="12,6" Click="FilterSongs_Click" Tag="synced"/>
                                </StackPanel>
                                <TextBox x:Name="SongSearchBox" Grid.Column="1" Margin="14,0,0,0" Width="260" HorizontalAlignment="Right"
                                         TextChanged="SongSearchBox_TextChanged" ToolTip="Filter songs by title, artist, or ID"/>
                            </Grid>
                        </Border>

                        <!-- Song Cards List -->
                        <StackPanel x:Name="SongsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 2: ONOGAMI SONG CREATOR ==================== -->
                    <StackPanel x:Name="PageCreator" Visibility="Collapsed">
                        <TextBlock Text="🔥 ONOGAMI Song Creator" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Create play-ready Guitar Hero III customs with bundled Honeycomb compilation, 6-stem Demucs AI isolation, and real pitch-mapped guitar charts."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <!-- Bundled Compiler + Auto-Install Banner -->
                        <Border Style="{StaticResource GhCard}" Background="#0D1F18" BorderBrush="#10B981">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚡ Bundled Honeycomb Compiler Engine" FontSize="14" FontWeight="Bold" Foreground="#34D399"/>
                                        <Border Background="#064E3B" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorCompilerBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#6EE7B7"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorCompilerMsg" Text="Zero separate Honeycomb install needed. Compiles .pak.xen &amp; .fsb.xen straight into BetterGH3."
                                               FontSize="12" Foreground="#A7F3D0" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="CrAutoCompileChk" Grid.Column="1" IsChecked="True" VerticalAlignment="Center"
                                          Content="Auto-Compile &amp; Install into Game" Foreground="#34D399" FontWeight="Bold"/>
                            </Grid>
                        </Border>

                        <!-- AI Engine Quick Banner inside Creator -->
                        <Border Style="{StaticResource GhCard}" Background="#10182B" BorderBrush="#3B82F6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🤖 Demucs 6-Stem (guitar.wav) + Spotify Basic Pitch AI" FontSize="14" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <Border x:Name="CreatorAiBadgeBorder" Background="#1E3A8A" CornerRadius="5" Padding="7,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="CreatorAiBadge" Text="Checking..." FontSize="11" FontWeight="Bold" Foreground="#BFDBFE"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="CreatorAiMsg" Text="Isolates the guitar stem for mute-on-miss gameplay and transcribes real guitar pitches, chords &amp; sustains."
                                               FontSize="12" Foreground="#93C5FD" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="CrSeparateStemsChk" Content="Use AI Stems &amp; Pitch" Foreground="#93C5FD" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <Button x:Name="CreatorQuickInstallAiBtn" Content="⬇ Install AI Engine" Style="{StaticResource BlueButton}"
                                            Padding="12,6" Click="GoToAiManager_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chart Mode & Form Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Chart Generation Mode" FontSize="13" FontWeight="Bold" Foreground="#FB923C" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <RadioButton x:Name="ModeAutoGenRadio" Content="🤖 Auto-Chart from Audio Pitch &amp; Guitar Stem (ONOGAMI AI)" Foreground="White" FontSize="13" IsChecked="True" Margin="0,0,24,0" Checked="ChartMode_Changed"/>
                                    <RadioButton x:Name="ModeUploadRadio" Content="📄 Upload Existing Chart / MIDI (.chart or .mid)" Foreground="White" FontSize="13" Checked="ChartMode_Changed"/>
                                </StackPanel>

                                <!-- Native File Pickers -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Audio File (.mp3, .wav, .ogg) *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="📂 Browse..." Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="BrowseAudioBtn_Click"/>
                                            <TextBox x:Name="CrAudioPathBox" IsReadOnly="True" Text="" ToolTip="Select your song audio file from disk"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="ChartPickerPanel" Grid.Column="2" Visibility="Collapsed">
                                        <TextBlock Text="Chart / MIDI File (.chart or .mid) *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,5"/>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="📂 Browse..." Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Click="BrowseChartBtn_Click"/>
                                            <TextBox x:Name="CrChartPathBox" IsReadOnly="True" Text=""/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="BpmPickerPanel" Grid.Column="2">
                                        <DockPanel Margin="0,0,0,5">
                                            <Button DockPanel.Dock="Right" Content="🎵 Auto-Detect BPM" Style="{StaticResource OutlineButton}" Padding="8,2" FontSize="11" Click="DetectBpmBtn_Click"/>
                                            <TextBlock Text="Song Tempo (BPM)" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock x:Name="BpmStatusLabel" DockPanel.Dock="Right" Text="" FontSize="11.5" Foreground="#34D399" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBox x:Name="CrBpmBox" Text="130"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Song Metadata Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="12"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Song Title *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrTitleBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Artist Name *" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrArtistBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Album" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrAlbumBox"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Year" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrYearBox" Text="2026"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Genre" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrGenreBox" Text="Rock"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="Charter Name" FontSize="12" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CrCharterBox" Text="ONOGAMI AI Creator"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Create Action + Live Progress -->
                                <StackPanel Margin="0,18,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CreateSongSubmitBtn" Content="⚡ Create &amp; Compile Song into Guitar Hero III"
                                                Style="{StaticResource FlameButton}" Padding="22,11" FontSize="14" Click="CreateSongBtn_Click"/>
                                        <TextBlock x:Name="CrProgressLabel" Text="" FontSize="12.5" Foreground="#FCD34D" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <ProgressBar x:Name="CrProgressBar" Visibility="Collapsed" Height="10" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
                                    <Border x:Name="CrResultBox" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="8" Padding="14" Background="#0D221A" BorderBrush="#10B981" BorderThickness="1">
                                        <TextBlock x:Name="CrResultText" TextWrapping="Wrap" Foreground="#A7F3D0" FontSize="12.5"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 3: AI & TOOLS MANAGER ==================== -->
                    <StackPanel x:Name="PageAiTools" Visibility="Collapsed">
                        <TextBlock Text="🤖 AI Engine &amp; Bundled Tools Manager" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Install and manage all local audio AI models and compilers with 1 click — zero Python setup or command prompts required."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <!-- Bundled Honeycomb Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="⚡ Bundled Honeycomb Compiler &amp; FFmpeg" FontSize="16" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock x:Name="AiToolsCompilerPath" Text="Checking bundled tools/compiler..." FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#064E3B" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                    <TextBlock x:Name="AiToolsCompilerStatus" Text="✓ Bundled &amp; Ready" FontSize="12" FontWeight="Bold" Foreground="#6EE7B7"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Demucs 6-Stem + Spotify Basic Pitch 1-Click Installer Card -->
                        <Border Style="{StaticResource GhCard}" BorderBrush="#3B82F6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="🎸 Demucs 6-Stem (htdemucs_6s) + Spotify Basic Pitch AI" FontSize="16" FontWeight="Bold" Foreground="#60A5FA"/>
                                        <TextBlock Text="Downloads a self-contained portable Python 3.11 + PyTorch + Meta Demucs 6-Stem + Spotify Basic Pitch AI runtime directly into AppData."
                                                   FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border x:Name="AiStatusPill" Grid.Column="1" Background="#3B2F0C" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock x:Name="AiStatusPillText" Text="Not Installed" FontSize="12" FontWeight="Bold" Foreground="#FDE047"/>
                                    </Border>
                                </Grid>

                                <!-- Component Status Pills -->
                                <WrapPanel Margin="0,4,0,14">
                                    <Border Background="#0C0E14" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompPython" Text="Portable Python 3.11: Checking..." FontSize="12" Foreground="#CBD5E1"/>
                                    </Border>
                                    <Border Background="#0C0E14" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompDemucs" Text="Demucs 6-Stem (guitar.wav): Checking..." FontSize="12" Foreground="#CBD5E1"/>
                                    </Border>
                                    <Border Background="#0C0E14" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompBasicPitch" Text="Spotify Basic Pitch MIDI AI: Checking..." FontSize="12" Foreground="#CBD5E1"/>
                                    </Border>
                                    <Border Background="#0C0E14" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                        <TextBlock x:Name="AiCompSize" Text="Disk Usage: 0 MB" FontSize="12" Foreground="#94A3B8"/>
                                    </Border>
                                </WrapPanel>

                                <!-- Action Buttons -->
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="InstallAiBtn" Content="⬇ 1-Click Install AI Engine (~700 MB - 1.2 GB)" Style="{StaticResource FlameButton}"
                                            Padding="18,10" Click="InstallAiEngineBtn_Click"/>
                                    <Button x:Name="UninstallAiBtn" Content="🗑️ Uninstall AI Engine" Style="{StaticResource DangerButton}"
                                            Margin="10,0,0,0" Visibility="Collapsed" Click="UninstallAiEngineBtn_Click"/>
                                    <Button Content="📂 Open AI Folder" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="OpenAiFolderBtn_Click"/>
                                </StackPanel>

                                <!-- Live Installer Progress -->
                                <StackPanel x:Name="AiInstallProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                                    <TextBlock x:Name="AiInstallStepText" Text="Preparing installation..." FontSize="12.5" Foreground="#FCD34D" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="AiInstallProgressBar" Height="12" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 4: FRIENDS & TRUST ==================== -->
                    <StackPanel x:Name="PageFriends" Visibility="Collapsed">
                        <TextBlock Text="👥 Friends &amp; Trusted Network" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Trusted friends automatically exchange connection addresses with zero manual IP or PIN entry. Regular friends keep IPs strictly private."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <!-- My Profile Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Your Display Name" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Save" Style="{StaticResource FlameButton}" Margin="8,0,0,0" Click="SaveUsernameBtn_Click"/>
                                        <TextBox x:Name="ProfileUsernameBox"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Your Permanent Friend Code" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="📋 Copy" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="CopyFriendCodeBtn_Click"/>
                                        <Button x:Name="ToggleCodeBtn" DockPanel.Dock="Right" Content="👁 Show" Style="{StaticResource OutlineButton}" Margin="6,0,0,0" Click="ToggleFriendCodeBtn_Click"/>
                                        <TextBox x:Name="ProfileFriendCodeBox" IsReadOnly="True" FontFamily="Consolas" FontWeight="Bold" Foreground="#FB923C"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Add Friend Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Add Friend by Code" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AddFriendCodeBox" Grid.Column="0" ToolTip="Friend Code (e.g. GH3-1234-ABCD)"/>
                                    <TextBox x:Name="AddFriendNameBox" Grid.Column="2" ToolTip="Friend Nickname"/>
                                    <Button Grid.Column="4" Content="+ Add Friend" Style="{StaticResource GreenButton}" Click="AddFriendBtn_Click"/>
                                </Grid>
                                <TextBlock Text="Left box: Friend Code (e.g. GH3-6475-71AF)  |  Right box: Nickname" FontSize="11" Foreground="#64748B" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Friends List -->
                        <StackPanel x:Name="FriendsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 5: P2P SYNC & NETWORK ==================== -->
                    <StackPanel x:Name="PageP2P" Visibility="Collapsed">
                        <TextBlock Text="🌐 P2P Song Sync &amp; Network (UPnP / WAN)" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Compare custom song libraries with friends over LAN or the Internet, auto-skip duplicates, and download missing tracks directly into BetterGH3."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <!-- Network Status Card -->
                        <Border Style="{StaticResource GhCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="P2pNetworkSummary" Text="Detecting Public IP &amp; UPnP NAT Mapping..." FontSize="13.5" FontWeight="Bold" Foreground="#60A5FA"/>
                                    <TextBlock x:Name="P2pPinSummary" Text="Session Pairing PIN: ------" FontSize="12" Foreground="#FCD34D" FontFamily="Consolas" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔄 Refresh NAT / UPnP" Style="{StaticResource OutlineButton}" VerticalAlignment="Center" Click="RefreshNatBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Connect to Peer Card -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Connect to a Friend's Library" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Peer Address (IP:Port or DDNS)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PeerAddressBox" Text="localhost:7373"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Session PIN (or Trusted Token)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PeerPinBox"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Content="🔍 Compare Libraries" Style="{StaticResource FlameButton}" VerticalAlignment="Bottom" Click="ComparePeerBtn_Click"/>
                                </Grid>
                                <TextBlock x:Name="PeerCompareStatus" Text="" FontSize="12.5" Foreground="#34D399"/>
                            </StackPanel>
                        </Border>

                        <!-- Peer Songs Results -->
                        <StackPanel x:Name="PeerSongsPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 6: IMPORT / EXPORT ==================== -->
                    <StackPanel x:Name="PageImport" Visibility="Collapsed">
                        <TextBlock Text="📦 Import &amp; Export Custom Archives" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Install .gh3song, .gh3pack, .sgh, or .zip song packs directly into BetterGH3 with automatic career save protection."
                                   FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,16"/>

                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="Import Song Archive from Disk" FontSize="15" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>
                                <TextBlock Text="Select any .gh3pack, .gh3song, .sgh, or .zip file to validate headers and install directly into Guitar Hero III."
                                           FontSize="12.5" Foreground="#94A3B8" Margin="0,0,0,14"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📂 Select Archive &amp; Import..." Style="{StaticResource GreenButton}" Click="ImportArchiveBtn_Click"/>
                                    <Button Content="📦 Export Full Library as .gh3pack" Style="{StaticResource FlameButton}" Margin="12,0,0,0" Click="ExportAllPack_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="ImportStatusText" Text="" FontSize="12.5" Foreground="#34D399" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== PAGE 7: CAREER SAVES ==================== -->
                    <StackPanel x:Name="PageSaves" Visibility="Collapsed">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="💾 Career Save Protection &amp; 1-Click Restore" FontSize="22" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Automatic snapshots of s000.d and toc.dat are created before every song compile, sync, import, or deletion."
                                           FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="💾 Backup Now" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="BackupSaveNowBtn_Click"/>
                                <Button Content="♻️ Restore Latest Career Save" Style="{StaticResource GreenButton}" Click="RestoreLatestSaveBtn_Click"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="SaveBackupsListPanel"/>
                    </StackPanel>

                    <!-- ==================== PAGE 8: LOGS, UPDATES & CREDITS ==================== -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <TextBlock Text="📜 Logs, Software Updates, Known Limitations &amp; Credits" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,14"/>

                        <!-- Software Updates Card -->
                        <Border Style="{StaticResource GhCard}" BorderBrush="#F59E0B">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🚀 GH3-Sync Auto-Updater" FontSize="15" FontWeight="Bold" Foreground="#FCD34D"/>
                                    <TextBlock x:Name="AboutUpdateStatus" Text="Current Version: 1.5.0-beta.5 (Checks GitHub automatically on startup)" FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="🔄 Check for Updates Now" Style="{StaticResource FlameButton}" VerticalAlignment="Center" Click="CheckUpdatesBtn_Click"/>
                            </Grid>
                        </Border>

                        <!-- Credits & Open-Source Acknowledgments -->
                        <Border Style="{StaticResource GhCard}" Background="#0D1D18" BorderBrush="#10B981">
                            <StackPanel>
                                <TextBlock Text="📜 Credits &amp; Open-Source Acknowledgments" FontSize="16" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#D1FAE5" FontSize="12.5" LineHeight="21">
                                    • Honeycomb-GUI &amp; GH-Toolkit-Core — AddyMills &amp; Neversoft modding community (PAK/QB chart compiler &amp; CRC key tables)&#x0a;
                                    • Demucs (htdemucs_6s) — Alexandre Défossez et al., Meta AI Research (6-stem AI guitar/bass/drums/vocals isolation)&#x0a;
                                    • Basic Pitch — Spotify Audio Intelligence Lab (MIT License; neural pitch-to-MIDI guitar transcription)&#x0a;
                                    • BetterGH3 — Marchello &amp; the BetterGH3 Mod Team (PC Guitar Hero III modernization &amp; online multiplayer)&#x0a;
                                    • Neversoft Entertainment &amp; Activision — Original Guitar Hero III: Legends of Rock&#x0a;
                                    • FFmpeg, FMOD/FSB Tools, NAudio (Mark Heath), DryWetMidi (Maxim Dobroselsky), Python-Build-Standalone (Astral)&#x0a;
                                    • Moonscraper &amp; Reaper Custom Charting Communities • Licensed under PolyForm Noncommercial License 1.0.0
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Version History & Known Limitations -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <TextBlock Text="⚠️ Version History &amp; Known Limitations" FontSize="15" FontWeight="Bold" Foreground="#FB923C" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12.5" LineHeight="20">
                                    • Beta 1: Initial P2P sync &amp; save backups. [Known limits: LAN-only, manual Honeycomb compilation, no peer file downloads]&#x0a;
                                    • Beta 2: Direct peer song downloads. [Known limits: manual Honeycomb compilation, manual port forwarding]&#x0a;
                                    • Beta 3: Automated UPnP / NAT-PMP &amp; public IP WAN sync. [Known limits: created songs stayed uncompiled projects]&#x0a;
                                    • Beta 4: Automated headless compilation &amp; action button fix. [Known limits: web-based UI, manual BPM, repeating 4-5 note pattern, no Demucs installer]&#x0a;
                                    • Beta 5 (Current): True Native Windows 11 GH3-themed app, animated intro, custom icon, 1-click Demucs 6-Stem + Basic Pitch AI installer, real pitch-mapped charting, individual song deletion, and GitHub auto-updater. [Known limits: First-time AI download is ~700MB–1.2GB; live variable tempo maps in progress]
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Live Diagnostic Logs -->
                        <Border Style="{StaticResource GhCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Content="🔄 Refresh Logs" Style="{StaticResource OutlineButton}" Padding="10,4" Click="RefreshLogsBtn_Click"/>
                                    <TextBlock Text="🛠️ Live Diagnostic Logs" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBox x:Name="LogsViewerBox" Height="220" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#07080C" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
