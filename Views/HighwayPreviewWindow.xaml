<Window x:Class="GH3_Sync.Views.HighwayPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync — Playable Highway Previewer &amp; Quick-Fix Editor"
        Width="940" Height="740"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#090A0F"
        Foreground="#F8FAFC"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="SongHeaderTitle" Text="Song Preview" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SongHeaderMeta" Text="Loading chart..." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Diff:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="DifficultyCombo" Width="96" Margin="0,0,8,0" SelectionChanged="DifficultyCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155"/>
                <TextBlock Text="Hyperspeed:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SpeedCombo" Width="74" SelectedIndex="2" Margin="0,0,8,0" SelectionChanged="SpeedCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155">
                    <ComboBoxItem Content="1.0x"/>
                    <ComboBoxItem Content="1.25x"/>
                    <ComboBoxItem Content="1.5x"/>
                    <ComboBoxItem Content="2.0x"/>
                    <ComboBoxItem Content="2.5x"/>
                </ComboBox>
                <TextBlock Text="Audio Speed:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="PracticeRateCombo" Width="72" SelectedIndex="3" SelectionChanged="PracticeRateCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155" ToolTip="Slow down audio &amp; highway for practicing hard solos">
                    <ComboBoxItem Content="50%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="90%"/>
                    <ComboBoxItem Content="100%"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Mode Selector + A->B Looper + Editor Controls -->
        <Border Grid.Row="1" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ModeWatchBtn" Content="👁 Watch" Padding="11,5" Margin="0,0,6,0" Background="#F97316" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="ModeBtn_Click" Tag="watch"/>
                    <Button x:Name="ModePlayBtn" Content="🎮 Playable Practice" Padding="11,5" Margin="0,0,6,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="ModeBtn_Click" Tag="play" ToolTip="Play with XInput Guitar Controller or Keyboard A S J K L + Space/Enter"/>
                    <Button x:Name="ModeEditBtn" Content="✏️ Quick-Fix Note Editor" Padding="11,5" Margin="0,0,14,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="ModeBtn_Click" Tag="edit" ToolTip="Left-click lanes to add/remove notes; Right-click a note to toggle HOPO"/>

                    <!-- A->B Solo Looper -->
                    <Button x:Name="SetLoopABtn" Content="Loop A" Padding="8,4" Margin="0,0,4,0" Background="#1E2436" Foreground="#7DD3FC" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="SetLoopABtn_Click"/>
                    <Button x:Name="SetLoopBBtn" Content="Loop B" Padding="8,4" Margin="0,0,4,0" Background="#1E2436" Foreground="#7DD3FC" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="SetLoopBBtn_Click"/>
                    <Button x:Name="ClearLoopBtn" Content="Clear Loop" Padding="8,4" Margin="0,0,8,0" Visibility="Collapsed" Background="#1E2436" Foreground="#FCA5A5" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="ClearLoopBtn_Click"/>
                    <TextBlock x:Name="LoopStatusText" Text="" FontSize="11.5" FontFamily="Consolas" Foreground="#38BDF8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Visual Editor Save/Undo Controls -->
                <StackPanel x:Name="EditorActionPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Undo" Padding="9,4" Margin="0,0,6,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="UndoEditBtn_Click"/>
                    <Button x:Name="SaveEditsBtn" Content="💾 Save Chart &amp; Recompile" Padding="11,5" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="SaveEditsBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 5-Fret Perspective Highway Stage -->
        <Border Grid.Row="2" Background="#05070D" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
            <Grid>
                <Canvas x:Name="HighwayCanvas" Background="Transparent" SizeChanged="HighwayCanvas_SizeChanged"
                        MouseLeftButtonDown="HighwayCanvas_MouseLeftButtonDown"
                        MouseRightButtonDown="HighwayCanvas_MouseRightButtonDown"/>

                <!-- Live HUD Pills inside Stage (Top-Left) -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14,12,0,0" IsHitTestVisible="False">
                    <Border Background="#CC0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,0,6">
                        <TextBlock x:Name="SectionPillText" Text="Section: Intro" FontSize="12" FontWeight="Bold" Foreground="#FDBA74"/>
                    </Border>
                    <Border Background="#CC0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,0,6">
                        <TextBlock x:Name="LiveStatsText" Text="BPM: 120.0  •  NPS: 0.0" FontSize="11.5" FontFamily="Consolas" Foreground="#7DD3FC"/>
                    </Border>
                    <Border x:Name="EditorHintPill" Visibility="Collapsed" Background="#CC1E1B4B" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="7" Padding="10,5">
                        <TextBlock Text="✏️ Edit Mode: Left-click lane to Add/Remove • Right-click to toggle HOPO" FontSize="11" Foreground="#C7D2FE"/>
                    </Border>
                </StackPanel>

                <!-- Playable Practice Scoreboard HUD (Top-Right) -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,12,14,0" IsHitTestVisible="False">
                    <Border x:Name="StarPowerBadge" Visibility="Collapsed" Margin="0,0,0,6"
                            Background="#CC082F49" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Padding="12,5">
                        <TextBlock Text="⚡ STAR POWER PHRASE" FontSize="12" FontWeight="ExtraBold" Foreground="#7DD3FC"/>
                    </Border>
                    <Border x:Name="PlayScoreHud" Visibility="Collapsed" Background="#DD0F172A" BorderBrush="#F97316" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                        <StackPanel>
                            <TextBlock x:Name="PlayScoreText" Text="0" FontSize="22" FontWeight="Black" FontFamily="Consolas" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="PlayStreakText" Text="Streak: 0 (1x)" FontSize="12" FontWeight="Bold" Foreground="#FDBA74" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="PlayAccuracyText" Text="100%  •  FC" FontSize="11.5" FontFamily="Consolas" Foreground="#6EE7B7" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            <TextBlock Text="Keys: A S J K L + Space/Enter • Or XInput Guitar" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Transport & Scrub Bar -->
        <Border Grid.Row="3" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="PlayPauseBtn" Content="▶ Play" Width="82" Padding="10,6" Margin="0,0,6,0"
                            Background="#F97316" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="PlayPauseBtn_Click"/>
                    <Button Content="⏹ Stop" Padding="10,6" Background="#1E2436" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="StopBtn_Click"/>
                </StackPanel>
                <Slider x:Name="SeekSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0"
                        PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
                <TextBlock x:Name="TimeLabel" Grid.Column="2" Text="0:00 / 0:00" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Live Audio-Chart Sync Offset Fine-Tuner -->
        <Border Grid.Row="4" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="10" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Audio-Chart Sync Offset" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="OffsetValueText" Text="0 ms (No Shift)" FontSize="11.5" FontFamily="Consolas" Foreground="#38BDF8"/>
                </StackPanel>
                <Slider x:Name="OffsetSlider" Grid.Column="1" Minimum="-250" Maximum="250" Value="0" TickFrequency="10" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OffsetSlider_ValueChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Reset 0ms" Padding="9,6" Margin="0,0,6,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="ResetOffsetBtn_Click"/>
                    <Button x:Name="SaveOffsetBtn" Content="Save Offset &amp; Recompile" Padding="12,6" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="SaveOffsetBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
