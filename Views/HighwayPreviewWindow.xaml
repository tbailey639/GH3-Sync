<Window x:Class="GH3_Sync.Views.HighwayPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync — Playable Highway Previewer &amp; Quick-Fix Editor"
        Width="940" Height="740"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#090A0F"
        Foreground="#F8FAFC"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="SongHeaderTitle" Text="Song Preview" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SongHeaderMeta" Text="Loading chart..." FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Palette:" FontSize="11.5" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="PaletteCombo" Width="96" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="PaletteCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155" ToolTip="Choose Note-Gem Color Palette (incl. Colorblind High-Contrast)">
                    <ComboBoxItem Content="Classic GH3"/>
                    <ComboBoxItem Content="Colorblind"/>
                    <ComboBoxItem Content="Synthwave"/>
                    <ComboBoxItem Content="Metallic"/>
                </ComboBox>
                <TextBlock Text="Track:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="TrackModeCombo" Width="136" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="TrackModeCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155" ToolTip="Switch between Lead Guitar, Co-Op Bass/Rhythm, or Side-by-Side Co-Op Split-Screen">
                    <ComboBoxItem Content="🎸 Lead Guitar"/>
                    <ComboBoxItem Content="🎸 Co-Op Bass"/>
                    <ComboBoxItem Content="👥 Co-Op Split-Screen"/>
                </ComboBox>
                <TextBlock Text="Diff:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="DifficultyCombo" Width="96" Margin="0,0,8,0" SelectionChanged="DifficultyCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155"/>
                <TextBlock Text="Hyperspeed:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="SpeedCombo" Width="74" SelectedIndex="2" Margin="0,0,8,0" SelectionChanged="SpeedCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155">
                    <ComboBoxItem Content="1.0x"/>
                    <ComboBoxItem Content="1.25x"/>
                    <ComboBoxItem Content="1.5x"/>
                    <ComboBoxItem Content="2.0x"/>
                    <ComboBoxItem Content="2.5x"/>
                </ComboBox>
                <TextBlock Text="Audio Speed:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="PracticeRateCombo" Width="72" SelectedIndex="3" SelectionChanged="PracticeRateCombo_SelectionChanged"
                          Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155" ToolTip="Slow down audio &amp; highway for practicing hard solos">
                    <ComboBoxItem Content="50%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="90%"/>
                    <ComboBoxItem Content="100%"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Mode Selector + A->B Looper + Editor Controls -->
        <Border Grid.Row="1" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ModeWatchBtn" Content="👁 Watch" Padding="11,5" Margin="0,0,6,0" Background="#F97316" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="ModeBtn_Click" Tag="watch"/>
                    <Button x:Name="ModePlayBtn" Content="🎮 Playable Practice" Padding="11,5" Margin="0,0,6,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="ModeBtn_Click" Tag="play" ToolTip="Play with XInput Guitar Controller or Keyboard A S J K L + Space/Enter"/>
                    <Button x:Name="ModeEditBtn" Content="✏️ Quick-Fix Note Editor" Padding="11,5" Margin="0,0,14,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="ModeBtn_Click" Tag="edit" ToolTip="Left-click lanes to add/remove notes; Right-click a note to toggle HOPO"/>

                    <!-- A->B Solo Looper -->
                    <Button x:Name="SetLoopABtn" Content="Loop A" Padding="8,4" Margin="0,0,4,0" Background="#1E2436" Foreground="#7DD3FC" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="SetLoopABtn_Click"/>
                    <Button x:Name="SetLoopBBtn" Content="Loop B" Padding="8,4" Margin="0,0,4,0" Background="#1E2436" Foreground="#7DD3FC" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="SetLoopBBtn_Click"/>
                    <Button x:Name="ClearLoopBtn" Content="Clear Loop" Padding="8,4" Margin="0,0,6,0" Visibility="Collapsed" Background="#1E2436" Foreground="#FCA5A5" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="ClearLoopBtn_Click"/>
                    <Button x:Name="BuildSoloCutBtn" Content="✂️ Build Solo Cut" Padding="8,4" Margin="0,0,6,0" Background="#312E81" Foreground="#C7D2FE" BorderBrush="#6366F1" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" Click="BuildSoloCutBtn_Click" ToolTip="Slice A→B loop into its own standalone playable GH3 custom song!"/>
                    <Button x:Name="RemapKeysBtn" Content="⌨️ Keys" Padding="8,4" Margin="0,0,6,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="RemapKeysBtn_Click" ToolTip="Customize keyboard fret &amp; strum keys"/>
                    <TextBlock x:Name="LoopStatusText" Text="" FontSize="11.5" FontFamily="Consolas" Foreground="#38BDF8" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Visual Editor Save/Undo Controls -->
                <StackPanel x:Name="EditorActionPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Button Content="Undo" Padding="9,4" Margin="0,0,6,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="UndoEditBtn_Click"/>
                    <Button x:Name="SaveEditsBtn" Content="💾 Save Chart &amp; Recompile" Padding="11,5" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="SaveEditsBtn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 5-Fret Perspective Highway Stage (Authentic GH3 Concert Arena) -->
        <Border Grid.Row="2" Background="#04060C" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12" ClipToBounds="True">
            <Grid>
                <!-- Stage Backdrop: Deep Night Arena + Atmospheric Concert Stage Lighting Spotlights -->
                <Canvas x:Name="StageBackdropCanvas" IsHitTestVisible="False">
                    <!-- Amber Left Stage Spotlight Beam -->
                    <Polygon Points="0,0 220,0 380,600 0,600" Opacity="0.12">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F59E0B" Offset="0.0"/>
                                <GradientStop Color="#EA580C" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                    <!-- Cyan / Magenta Right Stage Spotlight Beam -->
                    <Polygon Points="940,0 720,0 560,600 940,600" Opacity="0.10">
                        <Polygon.Fill>
                            <LinearGradientBrush StartPoint="1,0" EndPoint="0,1">
                                <GradientStop Color="#38BDF8" Offset="0.0"/>
                                <GradientStop Color="#A855F7" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Polygon.Fill>
                    </Polygon>
                    <!-- Bottom Stage Fog / Horizon Glow -->
                    <Border Canvas.Bottom="0" Canvas.Left="0" Width="1200" Height="140" Opacity="0.22">
                        <Border.Background>
                            <RadialGradientBrush Center="0.5,1.0" GradientOrigin="0.5,1.0" RadiusX="0.6" RadiusY="1.0">
                                <GradientStop Color="#F97316" Offset="0.0"/>
                                <GradientStop Color="#9333EA" Offset="0.55"/>
                                <GradientStop Color="Transparent" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Border.Background>
                    </Border>
                </Canvas>

                <Canvas x:Name="HighwayCanvas" Background="Transparent" SizeChanged="HighwayCanvas_SizeChanged"
                        MouseLeftButtonDown="HighwayCanvas_MouseLeftButtonDown"
                        MouseRightButtonDown="HighwayCanvas_MouseRightButtonDown"/>

                <!-- Live HUD Pills inside Stage (Top-Left) -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14,12,0,0" IsHitTestVisible="False">
                    <Border Background="#CC0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,0,6">
                        <TextBlock x:Name="SectionPillText" Text="Section: Intro" FontSize="12" FontWeight="Bold" Foreground="#FDBA74"/>
                    </Border>
                    <Border Background="#CC0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="7" Padding="10,5" Margin="0,0,0,6">
                        <TextBlock x:Name="LiveStatsText" Text="BPM: 120.0  •  NPS: 0.0" FontSize="11.5" FontFamily="Consolas" Foreground="#7DD3FC"/>
                    </Border>
                    <Border x:Name="EditorHintPill" Visibility="Collapsed" Background="#CC1E1B4B" BorderBrush="#818CF8" BorderThickness="1" CornerRadius="7" Padding="10,5">
                        <TextBlock Text="✏️ Edit Mode: Left-click lane to Add/Remove • Right-click to toggle HOPO" FontSize="11" Foreground="#C7D2FE"/>
                    </Border>
                </StackPanel>

                <!-- Playable Practice Scoreboard HUD (Top-Right) -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,12,14,0" IsHitTestVisible="False">
                    <Border x:Name="StarPowerBadge" Visibility="Collapsed" Margin="0,0,0,6"
                            Background="#CC082F49" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="8" Padding="12,5">
                        <TextBlock Text="⚡ STAR POWER PHRASE" FontSize="12" FontWeight="ExtraBold" Foreground="#7DD3FC"/>
                    </Border>
                    <Border x:Name="PlayScoreHud" Visibility="Collapsed" Background="#DD0F172A" BorderBrush="#F97316" BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                        <StackPanel Width="210">
                            <TextBlock x:Name="PlayScoreText" Text="0" FontSize="22" FontWeight="Black" FontFamily="Consolas" Foreground="#F8FAFC" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="PlayStreakText" Text="Streak: 0 (1x)" FontSize="12" FontWeight="Bold" Foreground="#FDBA74" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="PlayAccuracyText" Text="100%  •  FC" FontSize="11.5" FontFamily="Consolas" Foreground="#6EE7B7" HorizontalAlignment="Right" Margin="0,2,0,4"/>
                            <DockPanel Margin="0,2,0,2">
                                <TextBlock x:Name="PlayRockMeterLabel" DockPanel.Dock="Right" Text="ROCK: GREEN" FontSize="9.5" FontWeight="Bold" Foreground="#22C55E"/>
                                <TextBlock Text="ROCK METER" FontSize="9.5" Foreground="#94A3B8"/>
                            </DockPanel>
                            <ProgressBar x:Name="PlayRockMeterBar" Height="7" Minimum="0" Maximum="100" Value="75" Foreground="#22C55E" Background="#1E293B" Margin="0,0,0,5"/>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock x:Name="PlaySpChargeLabel" DockPanel.Dock="Right" Text="0%" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="⚡ STAR POWER (Create/RShift)" FontSize="9.5" Foreground="#7DD3FC"/>
                            </DockPanel>
                            <ProgressBar x:Name="PlaySpChargeBar" Height="7" Minimum="0" Maximum="100" Value="0" Foreground="#38BDF8" Background="#1E293B" Margin="0,0,0,5"/>
                            <TextBlock x:Name="PlayControllerHint" Text="DualSense Edge / Xbox / Guitar / Keys Ready" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Post-Song "★ YOU ROCK!" Results Summary Overlay -->
                <Border x:Name="PostSongResultsOverlay" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="#EE0B1020" BorderBrush="#F97316" BorderThickness="2" CornerRadius="14" Padding="26,20" Width="400">
                    <StackPanel>
                        <TextBlock x:Name="ResultsHeadlineText" Text="★ YOU ROCK! ★" FontSize="24" FontWeight="Black" Foreground="#FDBA74" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ResultsStarsText" Text="★★★★★" FontSize="26" Foreground="#FACC15" HorizontalAlignment="Center" Margin="0,2,0,10"/>
                        <TextBlock x:Name="ResultsScoreSummary" Text="Score: 0 • 100.0% • Max Streak: 0" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                        <TextBlock x:Name="ResultsDetailText" Text="" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="▶ Replay" Padding="14,7" Margin="0,0,8,0" Background="#F97316" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="ResultsReplayBtn_Click"/>
                            <Button Content="Close Summary" Padding="14,7" Background="#1E2436" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="ResultsCloseBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Transport & Scrub Bar -->
        <Border Grid.Row="3" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,10,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="PlayPauseBtn" Content="▶ Play" Width="82" Padding="10,6" Margin="0,0,6,0"
                            Background="#F97316" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="PlayPauseBtn_Click"/>
                    <Button Content="⏹ Stop" Padding="10,6" Background="#1E2436" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="StopBtn_Click"/>
                </StackPanel>

                <!-- Studio Guitar Coach & Note-Density Heatmap Scrub Strip -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <DockPanel Grid.Row="0" Margin="0,0,0,3">
                        <Button x:Name="CoachLoopSoloBtn" DockPanel.Dock="Right" Content="⚡ Loop Peak Solo"
                                Padding="8,2" FontSize="10.5" Background="#3B82F6" Foreground="White" BorderThickness="0"
                                FontWeight="Bold" Cursor="Hand" Click="CoachLoopSoloBtn_Click" ToolTip="Instantly set Loop A-B on the highest NPS shred solo"/>
                        <TextBlock x:Name="CoachInsightText" Text="🎸 STUDIO COACH: Analyzing chart note density..." FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Canvas x:Name="CoachHeatmapCanvas" Grid.Row="1" Height="8" Background="#0F172A" ClipToBounds="True" SizeChanged="CoachHeatmapCanvas_SizeChanged"/>

                    <Slider x:Name="SeekSlider" Grid.Row="2" VerticalAlignment="Center" Minimum="0" Maximum="100" Value="0" Margin="0,2,0,0"
                            PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
                </Grid>

                <TextBlock x:Name="TimeLabel" Grid.Column="2" Text="0:00 / 0:00" FontFamily="Consolas" FontSize="12" Foreground="#CBD5E1"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- Live Audio-Chart Sync Offset Fine-Tuner -->
        <Border Grid.Row="4" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="10" Padding="12,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Audio-Chart Sync Offset" FontSize="12.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="OffsetValueText" Text="0 ms (No Shift)" FontSize="11.5" FontFamily="Consolas" Foreground="#38BDF8"/>
                </StackPanel>
                <Slider x:Name="OffsetSlider" Grid.Column="1" Minimum="-250" Maximum="250" Value="0" TickFrequency="10" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" ValueChanged="OffsetSlider_ValueChanged"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Reset 0ms" Padding="9,6" Margin="0,0,6,0" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="ResetOffsetBtn_Click"/>
                    <Button x:Name="SaveOffsetBtn" Content="Save Offset &amp; Recompile" Padding="12,6" Background="#059669" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="SaveOffsetBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
