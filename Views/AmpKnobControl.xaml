<UserControl x:Class="GH3_Sync.Views.AmpKnobControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="110"
             Cursor="Hand"
             MouseLeftButtonDown="OnMouseDown"
             MouseLeftButtonUp="OnMouseUp"
             MouseMove="OnMouseMove"
             MouseWheel="OnMouseWheel">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="82"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Label -->
        <TextBlock x:Name="TxtHeader" Grid.Row="0" Text="VOLUME" FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,0,4"/>

        <!-- Dial Canvas (80x80) -->
        <Canvas Grid.Row="1" Width="82" Height="82" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Outer Faceplate Ring -->
            <Ellipse Width="82" Height="82" Stroke="#334155" StrokeThickness="1.5">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#1E293B" Offset="0.0"/>
                        <GradientStop Color="#0F172A" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Faceplate Markings 0 to 11 -->
            <TextBlock Text="0" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Canvas.Left="10" Canvas.Top="58"/>
            <TextBlock Text="1" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Canvas.Left="4" Canvas.Top="42"/>
            <TextBlock Text="3" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Canvas.Left="6" Canvas.Top="20"/>
            <TextBlock Text="5" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Canvas.Left="20" Canvas.Top="6"/>
            <TextBlock Text="6" FontSize="8.5" FontWeight="Bold" Foreground="#F59E0B" Canvas.Left="38" Canvas.Top="2"/>
            <TextBlock Text="7" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Canvas.Left="56" Canvas.Top="6"/>
            <TextBlock Text="9" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Canvas.Left="70" Canvas.Top="20"/>
            <TextBlock Text="10" FontSize="8.5" FontWeight="Bold" Foreground="#94A3B8" Canvas.Left="68" Canvas.Top="42"/>
            <TextBlock Text="11" FontSize="8.5" FontWeight="ExtraBold" Foreground="#EF4444" Canvas.Left="64" Canvas.Top="58"/>

            <!-- Center Rotary Brushed-Metal Knob Body (54x54) -->
            <Grid Canvas.Left="14" Canvas.Top="14" Width="54" Height="54" x:Name="KnobBody" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="KnobRotation" Angle="-135"/>
                </Grid.RenderTransform>

                <!-- Brushed Metal Knob Surface -->
                <Ellipse Width="54" Height="54" Stroke="#475569" StrokeThickness="2">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#334155" Offset="0.0"/>
                            <GradientStop Color="#0F172A" Offset="0.45"/>
                            <GradientStop Color="#1E293B" Offset="0.75"/>
                            <GradientStop Color="#090D16" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Inner Fluted Grip Ring -->
                <Ellipse Width="42" Height="42" Stroke="#64748B" StrokeThickness="1" StrokeDashArray="2 1"/>

                <!-- Pointer Indicator Needle Line -->
                <Line X1="27" Y1="6" X2="27" Y2="16" Stroke="#F97316" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Line.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#F97316" Opacity="0.8"/>
                    </Line.Effect>
                </Line>

                <!-- Center Cap Screw -->
                <Ellipse Width="10" Height="10" Fill="#1E293B" Stroke="#64748B" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Canvas>

        <!-- Current Value Display -->
        <TextBlock x:Name="TxtValue" Grid.Row="2" Text="6.0" FontSize="11" FontWeight="Bold"
                   Foreground="{DynamicResource AccentGoldText}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
    </Grid>
</UserControl>
