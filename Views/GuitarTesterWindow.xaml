<Window x:Class="GH3_Sync.Views.GuitarTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync — Universal Controller Tester (DualSense Edge • PS • Xbox • Guitar)"
        Width="780" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#090A0F"
        Foreground="#F8FAFC"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Border x:Name="ControllerStatusPill" DockPanel.Dock="Right" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                <TextBlock x:Name="ControllerStatusText" Text="Scanning XInput &amp; PlayStation HID..." FontSize="12" FontWeight="Bold" Foreground="#CBD5E1"/>
            </Border>
            <StackPanel>
                <TextBlock Text="🎮 Universal GH3 Controller Tester &amp; Remapper" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Instant plug-and-play support for DualSense Edge, DualSense, DualShock 4, Xbox controllers &amp; GH3 guitars — zero drivers needed."
                           FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Mode Selector & Custom Bind Hint -->
        <Border Grid.Row="1" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ResetPadBindsBtn" Content="Reset Custom Binds" Padding="10,4" Background="#1E2436" Foreground="#CBD5E1" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="ResetPadBindsBtn_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="GH3 Layout:" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LayoutModeCombo" Width="260" SelectedIndex="0" SelectionChanged="LayoutModeCombo_SelectionChanged"
                              Background="#141722" Foreground="#F8FAFC" BorderBrush="#334155">
                        <ComboBoxItem Content="Auto-Detect (Gamepad vs Guitar)"/>
                        <ComboBoxItem Content="🎮 Official GH3 Gamepad (L2/L1/R1/R2/✕)"/>
                        <ComboBoxItem Content="🎸 Official GH3 Guitar (A/B/Y/X/LB + Strum)"/>
                    </ComboBox>
                    <TextBlock x:Name="BindHintText" Text="  Click any fret box below to bind a DualSense Edge back paddle!" FontSize="11.5" Foreground="#7DD3FC" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Fretboard & Telemetry Visual -->
        <Border Grid.Row="2" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1.5" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 5 Fret Gems -->
                <TextBlock x:Name="FretMapCaption" Grid.Row="0" Text="5-FRET NECK BUTTONS (Official GH3 Mapping — Click any fret to custom-bind a pad button)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,12"/>
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,20">
                    <Border x:Name="FretG" Height="88" Margin="6,0" CornerRadius="12" Background="#0C1E14" BorderBrush="#22C55E" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="FretBox_Click" Tag="0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretGDot" Width="30" Height="30" Fill="#14532D" Stroke="#22C55E" StrokeThickness="2"/>
                            <TextBlock x:Name="FretGLabel" Text="GREEN (L2/LT)" FontSize="11" FontWeight="Bold" Foreground="#86EFAC" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretR" Height="88" Margin="6,0" CornerRadius="12" Background="#240D11" BorderBrush="#EF4444" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="FretBox_Click" Tag="1">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretRDot" Width="30" Height="30" Fill="#7F1D1D" Stroke="#EF4444" StrokeThickness="2"/>
                            <TextBlock x:Name="FretRLabel" Text="RED (L1/LB)" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretY" Height="88" Margin="6,0" CornerRadius="12" Background="#241D08" BorderBrush="#EAB308" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="FretBox_Click" Tag="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretYDot" Width="30" Height="30" Fill="#713F12" Stroke="#EAB308" StrokeThickness="2"/>
                            <TextBlock x:Name="FretYLabel" Text="YELLOW (R1/RB)" FontSize="11" FontWeight="Bold" Foreground="#FDE047" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretB" Height="88" Margin="6,0" CornerRadius="12" Background="#0C1930" BorderBrush="#3B82F6" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="FretBox_Click" Tag="3">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretBDot" Width="30" Height="30" Fill="#1E3A8A" Stroke="#3B82F6" StrokeThickness="2"/>
                            <TextBlock x:Name="FretBLabel" Text="BLUE (R2/RT)" FontSize="11" FontWeight="Bold" Foreground="#93C5FD" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretO" Height="88" Margin="6,0" CornerRadius="12" Background="#261207" BorderBrush="#F97316" BorderThickness="2" Cursor="Hand" MouseLeftButtonDown="FretBox_Click" Tag="4">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretODot" Width="30" Height="30" Fill="#7C2D12" Stroke="#F97316" StrokeThickness="2"/>
                            <TextBlock x:Name="FretOLabel" Text="ORANGE (✕/A)" FontSize="11" FontWeight="Bold" Foreground="#FDBA74" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Strum Bar + Triggers + Whammy + Star Power -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Strum & Menu Buttons -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STRUM BAR &amp; SYSTEM BUTTONS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Border x:Name="StrumUpBox" Height="44" Margin="0,0,6,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1.5">
                                <TextBlock Text="▲ STRUM UP" FontSize="12" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="StrumDownBox" Height="44" Margin="6,0,0,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1.5">
                                <TextBlock Text="▼ STRUM DOWN" FontSize="12" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Border x:Name="BtnStartBox" Height="38" Margin="0,0,6,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="OPTIONS / START" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBackBox" Height="38" Margin="6,0,0,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="⚡ STAR POWER (Create/Back)" FontSize="10.5" FontWeight="SemiBold" Foreground="#7DD3FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Whammy & Analog Trigger Meters -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="WHAMMY BAR &amp; ANALOG TRIGGERS (L2 / R2)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,3">
                            <TextBlock x:Name="WhammyValueText" DockPanel.Dock="Right" Text="0%" FontSize="11.5" FontFamily="Consolas" Foreground="#38BDF8"/>
                            <TextBlock Text="Whammy Axis (Left Stick / Whammy)" FontSize="11.5" Foreground="#CBD5E1"/>
                        </DockPanel>
                        <ProgressBar x:Name="WhammyBarMeter" Height="13" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>

                        <DockPanel Margin="0,0,0,3">
                            <TextBlock x:Name="L2ValueText" DockPanel.Dock="Right" Text="0%" FontSize="11.5" FontFamily="Consolas" Foreground="#86EFAC"/>
                            <TextBlock Text="L2 / LT Trigger (Green Fret)" FontSize="11.5" Foreground="#CBD5E1"/>
                        </DockPanel>
                        <ProgressBar x:Name="L2Meter" Height="12" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8"/>

                        <DockPanel Margin="0,0,0,3">
                            <TextBlock x:Name="R2ValueText" DockPanel.Dock="Right" Text="0%" FontSize="11.5" FontFamily="Consolas" Foreground="#93C5FD"/>
                            <TextBlock Text="R2 / RT Trigger (Blue Fret)" FontSize="11.5" Foreground="#CBD5E1"/>
                        </DockPanel>
                        <ProgressBar x:Name="R2Meter" Height="12" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="RawMaskText" Text="Scanning controllers..." FontFamily="Consolas" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Padding="18,7" Background="#1E2436" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="CloseBtn_Click"/>
        </DockPanel>
    </Grid>
</Window>
