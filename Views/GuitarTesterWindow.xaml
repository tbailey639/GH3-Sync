<Window x:Class="GH3_Sync.Views.GuitarTesterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync — Live Guitar Controller Diagnostic Tester"
        Width="740" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#090A0F"
        Foreground="#F8FAFC"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border x:Name="ControllerStatusPill" DockPanel.Dock="Right" Background="#1E293B" BorderBrush="#475569" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                <TextBlock x:Name="ControllerStatusText" Text="Scanning XInput (P1-P4)..." FontSize="12" FontWeight="Bold" Foreground="#CBD5E1"/>
            </Border>
            <StackPanel>
                <TextBlock Text="🎸 Live Guitar Controller Diagnostic Tester" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                <TextBlock Text="Press frets, strum up/down, push the whammy bar, or tilt your guitar (or test keyboard A/S/J/K/L + Enter) to verify inputs before launching GH3."
                           FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Fretboard & Telemetry Visual -->
        <Border Grid.Row="1" Background="#11131B" BorderBrush="#262B3D" BorderThickness="1.5" CornerRadius="12" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 5 Fret Gems -->
                <TextBlock Grid.Row="0" Text="5-FRET NECK BUTTONS (XInput A/B/Y/X/LB or Keys A S J K L)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,12"/>
                <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,22">
                    <Border x:Name="FretG" Height="82" Margin="6,0" CornerRadius="12" Background="#0C1E14" BorderBrush="#22C55E" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretGDot" Width="30" Height="30" Fill="#14532D" Stroke="#22C55E" StrokeThickness="2"/>
                            <TextBlock Text="GREEN (A)" FontSize="11.5" FontWeight="Bold" Foreground="#86EFAC" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretR" Height="82" Margin="6,0" CornerRadius="12" Background="#240D11" BorderBrush="#EF4444" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretRDot" Width="30" Height="30" Fill="#7F1D1D" Stroke="#EF4444" StrokeThickness="2"/>
                            <TextBlock Text="RED (B)" FontSize="11.5" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretY" Height="82" Margin="6,0" CornerRadius="12" Background="#241D08" BorderBrush="#EAB308" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretYDot" Width="30" Height="30" Fill="#713F12" Stroke="#EAB308" StrokeThickness="2"/>
                            <TextBlock Text="YELLOW (Y)" FontSize="11.5" FontWeight="Bold" Foreground="#FDE047" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretB" Height="82" Margin="6,0" CornerRadius="12" Background="#0C1930" BorderBrush="#3B82F6" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretBDot" Width="30" Height="30" Fill="#1E3A8A" Stroke="#3B82F6" StrokeThickness="2"/>
                            <TextBlock Text="BLUE (X)" FontSize="11.5" FontWeight="Bold" Foreground="#93C5FD" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="FretO" Height="82" Margin="6,0" CornerRadius="12" Background="#261207" BorderBrush="#F97316" BorderThickness="2">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse x:Name="FretODot" Width="30" Height="30" Fill="#7C2D12" Stroke="#F97316" StrokeThickness="2"/>
                            <TextBlock Text="ORANGE (LB)" FontSize="11.5" FontWeight="Bold" Foreground="#FDBA74" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Strum Bar + Whammy + Tilt + Start/Back -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Strum & Menu Buttons -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="STRUM BAR &amp; SYSTEM BUTTONS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,10">
                            <Border x:Name="StrumUpBox" Height="46" Margin="0,0,6,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1.5">
                                <TextBlock Text="▲ STRUM UP" FontSize="12.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="StrumDownBox" Height="46" Margin="6,0,0,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1.5">
                                <TextBlock Text="▼ STRUM DOWN" FontSize="12.5" FontWeight="Bold" Foreground="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                        <UniformGrid Columns="2">
                            <Border x:Name="BtnStartBox" Height="38" Margin="0,0,6,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="START (Pause)" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="BtnBackBox" Height="38" Margin="6,0,0,0" CornerRadius="8" Background="#141722" BorderBrush="#334155" BorderThickness="1">
                                <TextBlock Text="BACK (Star Power)" FontSize="11.5" FontWeight="SemiBold" Foreground="#7DD3FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </UniformGrid>
                    </StackPanel>

                    <!-- Whammy & Tilt Meters -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="WHAMMY BAR &amp; TILT SENSOR (ANALOG AXES)" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="WhammyValueText" DockPanel.Dock="Right" Text="0%" FontSize="12" FontFamily="Consolas" Foreground="#38BDF8"/>
                            <TextBlock Text="Whammy Bar Axis (Right Stick X)" FontSize="12" Foreground="#CBD5E1"/>
                        </DockPanel>
                        <ProgressBar x:Name="WhammyBarMeter" Height="16" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,14"/>

                        <DockPanel Margin="0,0,0,4">
                            <TextBlock x:Name="TiltValueText" DockPanel.Dock="Right" Text="0%" FontSize="12" FontFamily="Consolas" Foreground="#FDBA74"/>
                            <TextBlock Text="Star Power Tilt Axis (Right Stick Y)" FontSize="12" Foreground="#CBD5E1"/>
                        </DockPanel>
                        <ProgressBar x:Name="TiltMeter" Height="16" Minimum="0" Maximum="100" Value="0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="RawMaskText" Text="Raw XInput Mask: 0x0000" FontFamily="Consolas" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Padding="18,7" Background="#1E2436" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="CloseBtn_Click"/>
        </DockPanel>
    </Grid>
</Window>
