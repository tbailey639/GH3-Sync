    <LinearGradientBrush x:Key="FlameGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DC2626" Offset="0.0"/>
        <GradientStop Color="#EA580C" Offset="0.6"/>
        <GradientStop Color="#D97706" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="EmeraldGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#047857" Offset="0.0"/>
        <GradientStop Color="#059669" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="FretBarGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#16A34A" Offset="0.00"/>
        <GradientStop Color="#DC2626" Offset="0.25"/>
        <GradientStop Color="#CA8A04" Offset="0.50"/>
        <GradientStop Color="#2563EB" Offset="0.75"/>
        <GradientStop Color="#EA580C" Offset="1.00"/>
    </LinearGradientBrush>
</ResourceDictionary>
