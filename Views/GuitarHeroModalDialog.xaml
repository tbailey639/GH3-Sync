<Window x:Class="GH3_Sync.Views.GuitarHeroModalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guitar Hero III Dialog"
        Width="520" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Rock Dialog Button Template -->
        <ControlTemplate x:Key="RockDialogButtonTemplate" TargetType="Button">
            <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="btnBorder" Property="Opacity" Value="0.95"/>
                    <Setter TargetName="btnBorder" Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03"/></Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="btnBorder" Property="RenderTransform">
                        <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value>
                    </Setter>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Border Margin="18" CornerRadius="14" BorderThickness="1.5" x:Name="OuterBorder"
            BorderBrush="#F59E0B">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A1524" Offset="0"/>
                <GradientStop Color="#0E0C13" Offset="0.6"/>
                <GradientStop Color="#08070B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect x:Name="BorderGlow" Color="#F59E0B" BlurRadius="24" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#14111C" CornerRadius="12,12,0,0"
                    BorderThickness="0,0,0,1" BorderBrush="#2A2438"
                    Padding="16,10" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mini 5-fret gem accent -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse Width="7" Height="7" Fill="#22C55E" Margin="0,0,3,0"/>
                        <Ellipse Width="7" Height="7" Fill="#EF4444" Margin="0,0,3,0"/>
                        <Ellipse Width="7" Height="7" Fill="#EAB308" Margin="0,0,3,0"/>
                        <Ellipse Width="7" Height="7" Fill="#3B82F6" Margin="0,0,3,0"/>
                        <Ellipse Width="7" Height="7" Fill="#F97316" Margin="0,0,0,0"/>
                    </StackPanel>

                    <!-- Dialog Caption -->
                    <TextBlock Grid.Column="1" x:Name="DialogCaptionText" Text="GUITAR HERO III"
                               Foreground="#FCD34D" FontWeight="Bold" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                    <!-- Close button -->
                    <Button Grid.Column="2" Content="✕" Width="26" Height="26"
                            Background="Transparent" BorderThickness="0" Foreground="#94A3B8"
                            FontSize="13" FontWeight="Bold" Cursor="Hand" Click="CloseButton_Click"
                            ToolTip="Close (Esc)"/>
                </Grid>
            </Border>

            <!-- Main Body -->
            <Grid Grid.Row="1" Margin="22,18,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24"
                        x:Name="IconBadgeBorder" Background="#241B35"
                        BorderBrush="#F59E0B" BorderThickness="1.5"
                        VerticalAlignment="Top" Margin="0,2,16,0">
                    <TextBlock x:Name="IconGlyphText" Text="🎸" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Message Text -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="420" Margin="0,2,0,0">
                    <TextBlock x:Name="DialogMessageText" Text="Rock prompt goes here..."
                               Foreground="#F1F5F9" FontSize="13.5" LineHeight="20"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>

            <!-- Action Buttons Footer -->
            <Border Grid.Row="2" Background="#0F0D16" CornerRadius="0,0,12,12"
                    BorderThickness="0,1,0,0" BorderBrush="#251F32"
                    Padding="18,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" x:Name="ButtonPanel">
                    <!-- Button 1 (Primary / OK / Yes) -->
                    <Button x:Name="BtnPrimary" Content="🎸 ROCK ON!" MinWidth="110" Height="36"
                            Padding="16,6" Margin="6,0,0,0" Foreground="White" FontWeight="Bold" FontSize="12.5"
                            Template="{StaticResource RockDialogButtonTemplate}"
                            Cursor="Hand" Click="BtnPrimary_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F97316" Offset="0"/>
                                <GradientStop Color="#E11D48" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Button 2 (Secondary / No) -->
                    <Button x:Name="BtnSecondary" Content="✕ NO" MinWidth="95" Height="36"
                            Padding="16,6" Margin="8,0,0,0" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12.5"
                            Template="{StaticResource RockDialogButtonTemplate}"
                            Background="#1F1B2C" BorderBrush="#3B344D" BorderThickness="1"
                            Cursor="Hand" Click="BtnSecondary_Click" Visibility="Collapsed"/>

                    <!-- Button 3 (Cancel) -->
                    <Button x:Name="BtnCancel" Content="CANCEL" MinWidth="85" Height="36"
                            Padding="14,6" Margin="8,0,0,0" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"
                            Template="{StaticResource RockDialogButtonTemplate}"
                            Background="#181522" BorderBrush="#2A2438" BorderThickness="1"
                            Cursor="Hand" Click="BtnCancel_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
