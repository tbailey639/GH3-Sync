<UserControl x:Class="GH3_Sync.Views.StageHudProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="700" d:DesignHeight="95">
    
    <Border x:Name="HudContainer" Background="#14111D" BorderBrush="#362D4A" BorderThickness="1.5"
            CornerRadius="10" Padding="14,10" Margin="0,8">
        <Border.Effect>
            <DropShadowEffect x:Name="HudGlow" Color="#F59E0B" BlurRadius="18" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Line 1: Headline & 5-Fret Running Gem Wave & Percentage -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Step Headline -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeadline" Text="STAGE HUD ACTIVE"
                               Foreground="#FCD34D" FontWeight="Black" FontSize="12"/>
                </StackPanel>

                <!-- Sequenced 5-Fret Rock Gem Wave (Shows alive activity) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse x:Name="Gem1" Width="8" Height="8" Fill="#22C55E" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Gem2" Width="8" Height="8" Fill="#EF4444" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Gem3" Width="8" Height="8" Fill="#EAB308" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Gem4" Width="8" Height="8" Fill="#3B82F6" Margin="0,0,4,0"/>
                    <Ellipse x:Name="Gem5" Width="8" Height="8" Fill="#F97316" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- Percentage Readout -->
                <TextBlock Grid.Column="3" x:Name="TxtPercent" Text="0%"
                           Foreground="#F8FAFC" FontWeight="Bold" FontSize="12.5"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Line 2: Glowing Progress Bar -->
            <Border Grid.Row="1" Height="10" CornerRadius="5" Background="#0C0A12"
                    BorderBrush="#241D32" BorderThickness="1" Margin="0,2,0,5"
                    ClipToBounds="True">
                <Grid>
                    <ProgressBar x:Name="ProgressBarControl" Minimum="0" Maximum="100" Value="0"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="#F97316" Height="10"/>
                    <!-- Ambient Shimmer Streak -->
                    <Border x:Name="ShimmerBar" Width="60" HorizontalAlignment="Left" Opacity="0.3">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="#FFFFFF" Offset="0.5"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>

            <!-- Line 3: Detailed explanation of current step -->
            <TextBlock Grid.Row="2" x:Name="TxtDetail" Text="Engine standing by..."
                       Foreground="#94A3B8" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
