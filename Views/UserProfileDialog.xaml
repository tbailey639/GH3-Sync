<Window x:Class="GH3_Sync.Views.UserProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rockstar Profile"
        Width="640" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml"/>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Margin="16" CornerRadius="16" BorderThickness="2" x:Name="OuterBorder"
            BorderBrush="{DynamicResource AccentGold}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1A1524" Offset="0"/>
                <GradientStop Color="#0E0C13" Offset="0.65"/>
                <GradientStop Color="#08070B" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#F59E0B" BlurRadius="24" ShadowDepth="0" Opacity="0.55"/>
        </Border.Effect>

        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="4"/>     <!-- Fret Energy Strip -->
                <RowDefinition Height="Auto"/>  <!-- Rockstar Header -->
                <RowDefinition Height="Auto"/>  <!-- Showcase / Favorite Track -->
                <RowDefinition Height="Auto"/>  <!-- Career Stats Badges -->
                <RowDefinition Height="*"/>     <!-- Achievements / Trophies Showcase -->
                <RowDefinition Height="Auto"/>  <!-- Footer Action Buttons -->
            </Grid.RowDefinitions>

            <!-- Top Fret Energy Accent Strip -->
            <Border Grid.Row="0" Background="{DynamicResource FretBarGradient}"/>

            <!-- Rockstar Header -->
            <Grid Grid.Row="1" Margin="22,18,22,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Avatar Circle with Glowing Ring -->
                <Grid Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <Ellipse Width="64" Height="64" Stroke="{DynamicResource AccentGold}" StrokeThickness="2.5" Fill="#1E1929"/>
                    <TextBlock x:Name="AvatarEmoji" Text="🎸" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Name, Code & Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileUsername" Text="Rockstar" FontSize="20" FontWeight="Black" FontFamily="Impact, Segoe UI" Foreground="{DynamicResource TextPrimary}"/>
                        <Border x:Name="StatusBadgeBorder" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" Background="#064E3B">
                            <TextBlock x:Name="StatusBadgeText" Text="🟢 Online" FontSize="11" FontWeight="Bold" Foreground="#6EE7B7"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FRIEND CODE: " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ProfileCode" Text="GH3-XXXX-XXXX" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentFlameText}" VerticalAlignment="Center"/>
                        <Button x:Name="CopyCodeBtn" Content="📋 Copy" Style="{StaticResource OutlineButton}" Padding="6,1" FontSize="10" Margin="8,0,0,0" Click="CopyCodeBtn_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border x:Name="RelationshipBadgeBorder" CornerRadius="4" Padding="6,2" Background="#261B0E" BorderBrush="#F59E0B" BorderThickness="1">
                            <TextBlock x:Name="RelationshipBadgeText" Text="⭐ Trusted Friend (Song Sync Enabled)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentGold}"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Close Window X Button -->
                <Button Grid.Column="2" Content="✕" Width="30" Height="30" Background="Transparent" Foreground="{DynamicResource TextMuted}" BorderThickness="0" FontSize="16" Cursor="Hand" VerticalAlignment="Top" Click="CloseBtn_Click"/>
            </Grid>

            <!-- Signature / Showcase Track Card -->
            <Border Grid.Row="2" Style="{StaticResource GhCard}" Margin="20,0,20,10" Padding="14,10" Background="#14111E" BorderBrush="{DynamicResource BorderSubtle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🎵" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="FAVORITE / SIGNATURE TRACK" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentGold}"/>
                        <TextBlock x:Name="ShowcaseTrackTitle" Text="No signature track chosen yet" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,1,0,0"/>
                        <TextBlock x:Name="ShowcaseTrackSub" Text="BetterGH3 Custom Song Showcase" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="PreviewShowcaseBtn" Content="▶ Audio Preview" Style="{StaticResource BlueButton}" Padding="10,5" VerticalAlignment="Center" Click="PreviewShowcaseBtn_Click"/>
                </Grid>
            </Border>

            <!-- Career Statistics Bar -->
            <Grid Grid.Row="3" Margin="20,0,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Full Combos -->
                <Border Grid.Column="0" Background="#14111E" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="FULL COMBOS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatFullCombos" Text="0 👑" FontSize="15" FontWeight="Black" FontFamily="Impact" Foreground="{DynamicResource AccentGold}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 5-Stars -->
                <Border Grid.Column="1" Background="#14111E" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="5-STAR SONGS" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatFiveStars" Text="0 ⭐" FontSize="15" FontWeight="Black" FontFamily="Impact" Foreground="#22C55E" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Lifetime Notes -->
                <Border Grid.Column="2" Background="#14111E" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="NOTES HIT" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatNotesHit" Text="0 ⚡" FontSize="15" FontWeight="Black" FontFamily="Impact" Foreground="{DynamicResource AccentFlameText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Matches Played -->
                <Border Grid.Column="3" Background="#14111E" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="MATCHES PLAYED" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="StatMatchesPlayed" Text="0 ⚔️" FontSize="15" FontWeight="Black" FontFamily="Impact" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hall of Fame Achievements Showcase -->
            <Border Grid.Row="4" Margin="20,0,20,12" Background="#100E17" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TrophyHeader" Text="🏆 ROCK HALL OF FAME TROPHIES" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AccentGold}"/>
                        <TextBlock x:Name="TrophyCountText" Text="(0 / 14 Unlocked)" FontSize="11" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="TrophiesWrapPanel" Margin="0,2,0,0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Footer Action Buttons -->
            <Border Grid.Row="5" Background="#120F1C" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="20,14" CornerRadius="0,0,14,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="AskToPlayTogetherBtn" Content="🎸 Ask to Play Together!" Style="{StaticResource FlameButton}" Padding="16,8" Margin="0,0,8,0" Click="AskToPlayTogetherBtn_Click" ToolTip="Send real-time multiplayer session invite: '[You] wants to ROCK OUT with you!'"/>
                        <Button x:Name="SyncSongsBtn" Content="⚡ Sync Songs" Style="{StaticResource GreenButton}" Padding="14,8" Margin="0,0,8,0" Click="SyncSongsBtn_Click"/>
                        <Button x:Name="RequestTrustUpgradeBtn" Content="⭐ Request Trust Upgrade" Style="{StaticResource FlameButton}" Padding="14,8" Margin="0,0,8,0" Click="RequestTrustUpgradeBtn_Click"/>
                        <Button x:Name="AddRegularFriendBtn" Content="➕ Add Friend" Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,0" Click="AddRegularFriendBtn_Click"/>
                        <Button x:Name="AddTrustedFriendBtn" Content="⭐ Add Trusted Friend" Style="{StaticResource FlameButton}" Padding="14,8" Margin="0,0,8,0" Click="AddTrustedFriendBtn_Click"/>
                        <Button x:Name="ManageSavesBtn" Content="💾 Career Saves" Style="{StaticResource BlueButton}" Padding="14,8" Margin="0,0,8,0" Click="ManageSavesBtn_Click"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource OutlineButton}" Padding="14,8" HorizontalAlignment="Right" Click="CloseBtn_Click"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
