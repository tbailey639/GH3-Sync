<Window x:Class="GH3_Sync.Views.EncoreRouletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GH3-Sync — Encore Roulette Song Picker"
        Width="560" Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#090A0F"
        Foreground="#F8FAFC">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🎰 ENCORE ROULETTE" FontSize="22" FontWeight="Black" Foreground="#F97316" HorizontalAlignment="Center"/>
            <TextBlock x:Name="RoulettePoolLabel" Text="Spinning your installed custom songs..." FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Slot Machine Reel Window -->
        <Border x:Name="ReelFrame" Grid.Row="1" Background="#11131B" BorderBrush="#F97316" BorderThickness="2" CornerRadius="14" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="PrevSlotText" Text="..." FontSize="13" Foreground="#475569" HorizontalAlignment="Center" Margin="0,0,0,10" TextTrimming="CharacterEllipsis"/>
                <Border Background="#1B2030" BorderBrush="#F59E0B" BorderThickness="1.5" CornerRadius="10" Padding="20,14" MinWidth="440">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="SelectedTitleText" Text="Ready to Spin!" FontSize="22" FontWeight="Black" Foreground="#F8FAFC" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SelectedArtistText" Text="Click Spin Encore Roulette below" FontSize="13.5" Foreground="#FDBA74" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="NextSlotText" Text="..." FontSize="13" Foreground="#475569" HorizontalAlignment="Center" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button x:Name="SpinAgainBtn" Content="🎰 Spin Again" Padding="18,9" Margin="0,0,8,0"
                    Background="#F97316" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="SpinAgainBtn_Click"/>
            <Button x:Name="PreviewWinnerBtn" Content="▶ Preview" Padding="14,9" Margin="0,0,8,0" IsEnabled="False"
                    Background="#1E2436" Foreground="#E2E8F0" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="PreviewWinnerBtn_Click"/>
            <Button x:Name="HighwayWinnerBtn" Content="🎸 Play Highway" Padding="14,9" Margin="0,0,8,0" IsEnabled="False"
                    Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Click="HighwayWinnerBtn_Click"/>
            <Button Content="Close" Padding="14,9" Background="#1E2436" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Cursor="Hand" Click="CloseBtn_Click"/>
        </StackPanel>
    </Grid>
</Window>
