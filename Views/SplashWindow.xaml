<Window x:Class="GH3_Sync.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Width="560" Height="420"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DarkTheme.xaml"/>
                <ResourceDictionary Source="AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootCard" CornerRadius="18" Margin="16" Background="#0B0C12" BorderThickness="2">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#E11D48" Offset="0.0"/>
                <GradientStop Color="#F97316" Offset="0.5"/>
                <GradientStop Color="#F59E0B" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect Color="#F97316" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <!-- Top 5-Fret Highway Accent Strip -->
            <Border Height="4" VerticalAlignment="Top" CornerRadius="16,16,0,0" Background="{StaticResource FretBarGradient}"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <!-- Custom Emblem Logo with Scale & Glow Animation -->
                <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
                    <Ellipse Width="156" Height="156" Opacity="0.28">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#F97316" Offset="0.0"/>
                                <GradientStop Color="#E11D48" Offset="0.55"/>
                                <GradientStop Color="Transparent" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Image x:Name="LogoImage"
                           Source="pack://application:,,,/Assets/gh3_sync_logo.png"
                           Width="136" Height="136"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="LogoScale" ScaleX="0.72" ScaleY="0.72"/>
                        </Image.RenderTransform>
                    </Image>
                </Grid>

                <!-- Title -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="GH3" FontSize="34" FontWeight="Black" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="-SYNC" FontSize="34" FontWeight="Black" Foreground="{StaticResource FlameGradient}" FontFamily="Segoe UI"/>
                </StackPanel>

                <TextBlock x:Name="SplashVersionSubtitle" Text="v1.4.4  •  STUDIO EDITION  •  BY MAD SCIENTIST"
                           FontSize="12" FontWeight="Bold" Foreground="#F59E0B"
                           HorizontalAlignment="Center" Margin="0,0,0,18"/>

                <!-- Animated 5-Fret Highway Gems -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse x:Name="GemGreen" Width="16" Height="16" Margin="6,0" Fill="#22C55E" Opacity="0.25">
                        <Ellipse.Effect><DropShadowEffect Color="#22C55E" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="GemRed" Width="16" Height="16" Margin="6,0" Fill="#EF4444" Opacity="0.25">
                        <Ellipse.Effect><DropShadowEffect Color="#EF4444" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="GemYellow" Width="16" Height="16" Margin="6,0" Fill="#EAB308" Opacity="0.25">
                        <Ellipse.Effect><DropShadowEffect Color="#EAB308" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="GemBlue" Width="16" Height="16" Margin="6,0" Fill="#3B82F6" Opacity="0.25">
                        <Ellipse.Effect><DropShadowEffect Color="#3B82F6" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                    <Ellipse x:Name="GemOrange" Width="16" Height="16" Margin="6,0" Fill="#F97316" Opacity="0.25">
                        <Ellipse.Effect><DropShadowEffect Color="#F97316" BlurRadius="12" ShadowDepth="0"/></Ellipse.Effect>
                    </Ellipse>
                </StackPanel>

                <!-- Startup Progress -->
                <ProgressBar x:Name="SplashProgress" Width="390" Height="8" Minimum="0" Maximum="100" Value="10" Margin="0,0,0,10"/>
                <TextBlock x:Name="StatusText" Text="Starting Guitar Hero III Companion Engine..."
                           FontSize="12.5" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
