<UserControl x:Class="GH3_Sync.Views.VintageToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="70" d:DesignWidth="220"
             Cursor="Hand"
             MouseLeftButtonDown="OnToggleClick">
    <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="1.5" CornerRadius="6" Padding="10,6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Vintage Chrome Lever Box (32x48) -->
            <Canvas Grid.Column="0" Width="36" Height="48" Margin="0,0,10,0">
                <!-- Beveled Switch Bushing / Nut -->
                <Ellipse Canvas.Left="4" Canvas.Top="10" Width="28" Height="28" Fill="#334155" Stroke="#64748B" StrokeThickness="1.5"/>
                <Ellipse Canvas.Left="8" Canvas.Top="14" Width="20" Height="20" Fill="#0F172A" Stroke="#475569" StrokeThickness="1"/>

                <!-- Chrome Bat Lever -->
                <Grid x:Name="LeverBat" Canvas.Left="15" Canvas.Top="4" Width="6" Height="40" RenderTransformOrigin="0.5,0.7">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="LeverRotation" Angle="28"/>
                    </Grid.RenderTransform>
                    <!-- Lever Stem -->
                    <Rectangle Width="4" Height="26" Fill="#CBD5E1" Stroke="#94A3B8" StrokeThickness="0.5" RadiusX="2" RadiusY="2" HorizontalAlignment="Center"/>
                    <!-- Chrome Tip Ball -->
                    <Ellipse Width="8" Height="8" Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Fill="#F8FAFC" Stroke="#94A3B8" StrokeThickness="1">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.6" Color="#000000"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
            </Canvas>

            <!-- Jewel Pilot Light Lamp -->
            <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <!-- Outer Bezel -->
                <Ellipse Width="18" Height="18" Fill="#1E293B" Stroke="#64748B" StrokeThickness="1.5"/>
                <!-- Faceted Jewel Lens -->
                <Ellipse x:Name="JewelLamp" Width="12" Height="12" Fill="#451A03" Stroke="#78350F" StrokeThickness="1">
                    <Ellipse.Effect>
                        <DropShadowEffect x:Name="JewelGlow" BlurRadius="8" ShadowDepth="0" Color="#F59E0B" Opacity="0"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>

            <!-- Label and State Text -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLabel" Text="CHROME TOGGLE" FontSize="12.5" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="TxtStatus" Text="OFF" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMuted}" Margin="0,1,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
